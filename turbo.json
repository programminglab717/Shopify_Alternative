{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_ADMIN_URL", "DATABASE_POOLER_URL", "REDIS_URL"],
      "outputs": [],
      "passThroughEnv": ["UPDATE_SCHEMA"]
    },
    "@hatti/core#test": {
      "dependsOn": ["^build", "build"],
      "env": ["DATABASE_ADMIN_URL", "DATABASE_POOLER_URL", "REDIS_URL"],
      "passThroughEnv": ["UPDATE_SCHEMA"],
      "outputs": []
    }
  }
}
