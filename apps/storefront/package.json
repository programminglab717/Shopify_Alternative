{
  "name": "@hatti/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "Spike 1: the storefront renderer. Renders Liquid themes with Shopify-style JSON templates, sections and blocks, within hard limits.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "node --enable-source-maps dist/cli/bench.js",
    "serve": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/cli/instrumentation.js dist/cli/serve.js"
  },
  "dependencies": {
    "@hatti/crypto": "workspace:*",
    "@hatti/documents": "workspace:*",
    "@hatti/logger": "workspace:*",
    "@hatti/money": "workspace:*",
    "@hatti/ratelimit": "workspace:*",
    "@hatti/storefront-api": "workspace:*",
    "@hatti/storefront-data": "workspace:*",
    "@hatti/telemetry": "workspace:*",
    "@hatti/themes": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "fastify": "catalog:",
    "graphql": "catalog:",
    "ioredis": "catalog:",
    "liquidjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "axe-core": "4.14.0",
    "happy-dom": "20.14.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
