{
  "name": "@hatti/core",
  "version": "0.0.0",
  "private": true,
  "description": "The core modular monolith: Admin GraphQL API, background worker and outbox relay.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start:api": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/instrumentation.js dist/worker.js",
    "seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/seed.js"
  },
  "dependencies": {
    "@hatti/api": "workspace:*",
    "@hatti/catalog": "workspace:*",
    "@hatti/checkout": "workspace:*",
    "@hatti/config": "workspace:*",
    "@hatti/crypto": "workspace:*",
    "@hatti/customers": "workspace:*",
    "@hatti/db": "workspace:*",
    "@hatti/events": "workspace:*",
    "@hatti/files": "workspace:*",
    "@hatti/identity": "workspace:*",
    "@hatti/ids": "workspace:*",
    "@hatti/inventory": "workspace:*",
    "@hatti/logger": "workspace:*",
    "@hatti/logistics": "workspace:*",
    "@hatti/marketing": "workspace:*",
    "@hatti/messaging": "workspace:*",
    "@hatti/money": "workspace:*",
    "@hatti/online-store": "workspace:*",
    "@hatti/orders": "workspace:*",
    "@hatti/pk": "workspace:*",
    "@hatti/pricing": "workspace:*",
    "@hatti/ratelimit": "workspace:*",
    "@hatti/storage": "workspace:*",
    "@hatti/storefront-api": "workspace:*",
    "@hatti/storefront-data": "workspace:*",
    "@hatti/tax": "workspace:*",
    "@hatti/telemetry": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/mercurius": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@opentelemetry/api": "catalog:",
    "busboy": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "graphql": "catalog:",
    "ioredis": "catalog:",
    "mercurius": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@types/busboy": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
