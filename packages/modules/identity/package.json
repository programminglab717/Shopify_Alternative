{
  "name": "@hatti/identity",
  "version": "0.0.0",
  "private": true,
  "description": "Staff identity: accounts, passwords, two-step verification, sessions and shop memberships. Other code imports only @hatti/identity/public.",
  "type": "module",
  "exports": {
    "./public": {
      "types": "./dist/public/index.d.ts",
      "default": "./dist/public/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hatti/api": "workspace:*",
    "@hatti/crypto": "workspace:*",
    "@hatti/db": "workspace:*",
    "@hatti/ids": "workspace:*",
    "@hatti/money": "workspace:*",
    "@hatti/pk": "workspace:*",
    "@hatti/ratelimit": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "fastify": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
