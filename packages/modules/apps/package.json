{
  "name": "@hatti/apps",
  "version": "0.0.0",
  "private": true,
  "description": "Apps module: the shop's custom apps, each an access token with its scopes and a secret its webhooks are signed with, and its Admin API. Other code imports only @hatti/apps/public.",
  "type": "module",
  "exports": {
    "./public": {
      "types": "./dist/public/index.d.ts",
      "default": "./dist/public/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hatti/api": "workspace:*",
    "@hatti/crypto": "workspace:*",
    "@hatti/db": "workspace:*",
    "@hatti/events": "workspace:*",
    "@hatti/ids": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/graphql": "catalog:",
    "graphql": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@hatti/telemetry": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "graphql": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
