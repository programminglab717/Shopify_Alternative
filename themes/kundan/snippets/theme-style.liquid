{%- comment -%}
  Kundan (ADR-734): Hatti Base set for jewellery. Fewer, larger pieces to a row, each photo square
  and filled as jewellery is shot close; serif headings in English with Nastaliq kept in Urdu,
  section titles centred over a thin gold rule, and squared buttons.
{%- endcomment -%}
{% style %}
  h1,
  h2,
  h3,
  .card__title {
    font-family: 'Noto Serif', Georgia, 'Times New Roman', serif;
  }
  html[lang='ur'] h1,
  html[lang='ur'] h2,
  html[lang='ur'] h3,
  html[lang='ur'] .card__title {
    font-family: var(--font-urdu);
  }
  .card__media {
    aspect-ratio: 1 / 1;
    border-radius: 0;
  }
  .card__title {
    text-align: center;
  }
  .card .price {
    justify-content: center;
  }
  .section-title {
    flex-direction: column;
    align-items: center;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-accent);
  }
  .button {
    border-radius: 0;
    letter-spacing: 0.04em;
  }
  html .banner {
    background: #1c1917;
  }
  @media (min-width: 990px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }
{% endstyle %}
