{%- comment -%}
  A heart that keeps `product` in the shopper's wishlist (OS-12, ADR-418), in their browser
  alone, as pages are the same for every shopper: the header's script shows it, pressed while
  the product is in the list, and turns it on and off. Without scripts it stays hidden.
{%- endcomment -%}
<button
  type="button"
  class="wishlist-button"
  data-wishlist="{{ product.handle }}"
  aria-pressed="false"
  aria-label="{{ 'products.wishlist.save' | t: title: product.title | escape }}"
  hidden
>
  <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22">
    <path d="M12 20.5s-7.3-4.4-9.3-8.9C1.3 8.5 3.1 4.5 6.8 4.5c2.1 0 3.5 1.2 4.3 2.5h1.8c.8-1.3 2.2-2.5 4.3-2.5 3.7 0 5.5 4 4.1 7.1-2 4.5-9.3 8.9-9.3 8.9z" />
  </svg>
</button>
