{%- comment -%}
  An address form's fields (ADR-584), inside `{% form 'customer_address', address %}`: `form`
  holds the address, or what was just typed in it and refused; `key` tells one form's fields from
  another's on the page.
{%- endcomment -%}
<div class="addresses__fields">
  <label for="AddressName_{{ key }}">{{ 'customer.addresses.name' | t }}</label>
  <input id="AddressName_{{ key }}" type="text" name="address[name]" value="{{ form.name | escape }}" autocomplete="name" dir="auto" required>

  <label for="AddressPhone_{{ key }}">{{ 'customer.addresses.phone' | t }}</label>
  <input id="AddressPhone_{{ key }}" type="tel" name="address[phone]" value="{{ form.phone | escape }}" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="0300 1234567" required>

  <label for="AddressLine1_{{ key }}">{{ 'customer.addresses.address1' | t }}</label>
  <input id="AddressLine1_{{ key }}" type="text" name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1" dir="auto" required>

  <label for="AddressLine2_{{ key }}">{{ 'customer.addresses.address2' | t }}</label>
  <input id="AddressLine2_{{ key }}" type="text" name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2" dir="auto">

  <label for="AddressLandmark_{{ key }}">{{ 'customer.addresses.landmark' | t }}</label>
  <input id="AddressLandmark_{{ key }}" type="text" name="address[landmark]" value="{{ form.landmark | escape }}" dir="auto">

  <label for="AddressCity_{{ key }}">{{ 'customer.addresses.city' | t }}</label>
  <input id="AddressCity_{{ key }}" type="text" name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2" dir="auto" required>

  <label for="AddressProvince_{{ key }}">{{ 'customer.addresses.province' | t }}</label>
  <input id="AddressProvince_{{ key }}" type="text" name="address[province]" value="{{ form.province | escape }}" autocomplete="address-level1" dir="auto">

  <label for="AddressZip_{{ key }}">{{ 'customer.addresses.zip' | t }}</label>
  <input id="AddressZip_{{ key }}" type="text" name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code" inputmode="numeric" dir="ltr">

  <label class="addresses__check">
    {{ form.set_as_default_checkbox }}
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
</div>
{%- if form.errors -%}
  <div class="addresses__error" role="alert">
    {%- for error in form.errors -%}
      <p>{{ error | escape }}</p>
    {%- endfor -%}
  </div>
{%- endif -%}
<button class="button" type="submit">{{ 'customer.addresses.save' | t }}</button>
