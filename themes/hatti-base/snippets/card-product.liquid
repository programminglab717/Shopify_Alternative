{%- comment -%}
  A product in a grid: its image, title and price, with a badge for a sale or when it is sold
  out, and a heart for the shopper's wishlist. The first two cards load their images at once;
  the rest when they come into view. A combined listing the shop shows as one card (ADR-901)
  names its values under the title: four, and how many more.
{%- endcomment -%}
{%- liquid
  if position > 2
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif
  assign image = product.featured_image
  assign alt = image.alt | default: product.title
-%}
<div class="card">
  <a href="{{ product.url }}" class="card__link">
    <div class="card__media">
      {%- if image -%}
        {{
          image
          | image_url: width: 533
          | image_tag:
            widths: '165, 360, 533',
            sizes: '(min-width: 990px) 25vw, 50vw',
            loading: loading,
            alt: alt
        }}
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="badge">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.preorder_ships_on -%}
        <span class="badge badge--preorder">{{ 'products.product.preorder' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </div>
    <h3 class="card__title" dir="auto">{{ product.title | escape }}</h3>
    {%- if product.combined_listing.one_card -%}
      {%- assign values = product.combined_listing.values -%}
      <p class="card__values" dir="auto">
        {%- for value in values limit: 4 -%}
          {{- value.name | escape -}}
          {%- unless forloop.last %} · {% endunless -%}
        {%- endfor -%}
        {%- if values.size > 4 -%}
          {%- assign more = values.size | minus: 4 %}
          · {{ 'products.product.more_values' | t: count: more -}}
        {%- endif -%}
      </p>
    {%- endif -%}
  </a>
  {% render 'wishlist-button', product: product %}
  {% render 'rating', product: product %}
  {% render 'price', product: product %}
  {%- comment -%}
    A signed-in reseller's own price (CUS-06, ADR-782), the lowest of its variants', asked for by
    the header's script: each variant's ID and its price to anyone.
  {%- endcomment -%}
  <p
    class="card__own-price"
    data-card-own-price="{% for variant in product.variants %}{{ variant.id }}:{{ variant.price }}{% unless forloop.last %},{% endunless %}{% endfor %}"
    data-price="{{ product.price }}"
    data-words="{{ 'products.product.price.yours' | t: price: '{price}' | escape }}"
    hidden
  ></p>
</div>
