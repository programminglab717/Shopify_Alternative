<header class="header" data-root="{{ routes.root_url }}">
  <div class="page-width header__inner">
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if shop.brand.logo -%}
        <img src="{{ shop.brand.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" class="header__logo-image">
      {%- else -%}
        {{ shop.name | escape }}
      {%- endif -%}
    </a>
    {%- comment -%}
      On phones, the menu is a drawer opened from the header; wider, it runs across the page,
      its links with links under them opening below (ADR-641). Neither needs a script.
    {%- endcomment -%}
    <details class="header__drawer">
      <summary>{{ 'general.menu_open' | t }}</summary>
      <nav class="header__drawer-nav" aria-label="{{ 'general.menu' | t }}">
        {%- render 'header-menu', menu: section.settings.menu -%}
      </nav>
    </details>
    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      {%- render 'header-menu', menu: section.settings.menu -%}
    </nav>
    <div class="header__tools">
      <details class="header__search">
        <summary>{{ 'general.search' | t }}</summary>
        <hatti-search class="search-panel" data-url="{{ routes.predictive_search_url }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="page-width search-panel__form">
            <label for="header-search" class="visually-hidden">{{ 'sections.search.label' | t }}</label>
            <input
              id="header-search"
              type="search"
              name="q"
              placeholder="{{ 'sections.search.placeholder' | t }}"
              dir="auto"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="predictive-search-results"
              aria-autocomplete="list"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="button">{{ 'sections.search.submit' | t }}</button>
          </form>
          <div class="page-width search-panel__results" data-results hidden></div>
        </hatti-search>
      </details>
      {%- if request.locale.iso_code == 'ur' -%}
        <a href="{{ request.path }}" lang="en" hreflang="en">{{ 'general.language' | t }}</a>
      {%- else -%}
        <a href="/ur{{ request.path }}" lang="ur" hreflang="ur">{{ 'general.language' | t }}</a>
      {%- endif -%}
      {%- if section.settings.wishlist -%}
        {%- if routes.root_url == '/' -%}
          {%- assign wishlist_url = '/pages/wishlist' -%}
        {%- else -%}
          {%- assign wishlist_url = routes.root_url | append: '/pages/wishlist' -%}
        {%- endif -%}
        <a href="{{ wishlist_url }}" class="header__wishlist">
          {{- 'general.wishlist' | t }} <span class="count" data-wishlist-count hidden></span>
        </a>
      {%- endif -%}
      {%- comment -%}
        The shopper's account (ADR-571): it sends them to sign in when they are not. Pages are the
        same for every shopper, so a script says "Account" on them once they are signed in.
      {%- endcomment -%}
      <a href="{{ routes.account_url }}" class="header__account" data-account-link data-signed-in="{{ 'general.account' | t }}">
        {%- if customer %}{{ 'general.account' | t }}{% else %}{{ 'general.sign_in' | t }}{% endif -%}
      </a>
      <a href="{{ routes.cart_url }}" class="header__cart" data-cart-link>
        {{- 'general.cart' | t }} <span class="count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header { position: relative; border-block-end: 1px solid var(--color-border); }
  .header__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; padding-block: 0.75rem; }
  .header__logo { font-weight: 700; font-size: 1.25rem; color: inherit; text-decoration: none; }
  .header__logo-image { display: block; block-size: 2.5rem; inline-size: auto; max-inline-size: 12rem; object-fit: contain; }
  .header__menu, .header__children, .header__grandchildren { margin: 0; padding: 0; list-style: none; }
  .header__menu a, .header__submenu > summary { color: inherit; text-decoration: none; }
  .header__submenu > summary { cursor: pointer; list-style: none; }
  .header__submenu > summary::-webkit-details-marker, .header__drawer > summary::-webkit-details-marker { display: none; }
  .header__submenu > summary::after { content: ' ▾'; }
  .header__grandchildren { padding-inline-start: 1rem; }
  /* Phones: a drawer of the menu, each link a row, the links under it opening below it. */
  .header__drawer { order: -1; }
  .header__drawer > summary { cursor: pointer; list-style: none; text-decoration: underline; }
  .header__drawer-nav { position: absolute; inset-inline: 0; inset-block-start: 100%; z-index: 10; max-block-size: 80vh; overflow-y: auto; padding: 0.75rem 1rem; border-block-end: 1px solid var(--color-border); background: var(--color-background); }
  .header__drawer-nav .header__menu > li, .header__drawer-nav .header__children > li { padding-block: 0.5rem; }
  .header__drawer-nav .header__children { padding-inline-start: 1rem; }
  .header__nav { display: none; }
  @media (min-width: 750px) {
    .header__drawer { display: none; }
    .header__nav { display: block; }
    .header__nav > .header__menu { display: flex; gap: 1.25rem; white-space: nowrap; }
    .header__nav .header__submenu { position: relative; }
    .header__nav .header__children { position: absolute; inset-inline-start: 0; inset-block-start: 100%; z-index: 10; min-inline-size: 12rem; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-background); white-space: normal; }
    .header__nav .header__children > li { padding-block: 0.25rem; }
  }
  .header__tools { display: flex; gap: 1rem; margin-inline-start: auto; }
  .header__cart .count, .header__wishlist .count { display: inline-block; min-inline-size: 1.5em; border-radius: 1em; background: var(--color-accent); color: #fff; text-align: center; }
  .header__search > summary { cursor: pointer; list-style: none; text-decoration: underline; }
  .header__search > summary::-webkit-details-marker { display: none; }
  .search-panel { position: absolute; inset-inline: 0; inset-block-start: 100%; z-index: 10; padding-block: 0.75rem; border-block-end: 1px solid var(--color-border); background: var(--color-background); }
  .search-panel__form { display: flex; gap: 0.5rem; }
  .search-panel__form input[type='search'] { flex: 1; min-inline-size: 0; min-block-size: 2.75rem; padding: 0.5rem 0.75rem; border: 1px solid var(--color-muted); border-radius: 0.5rem; background: var(--color-background); color: inherit; font: inherit; }
  .predictive-search { margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .predictive-search__link { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; border-radius: 0.5rem; color: inherit; text-decoration: none; }
  .predictive-search__link img { inline-size: 48px; border-radius: 0.25rem; }
  .predictive-search__title { flex: 1; }
  .predictive-search__kind { font-size: 0.875rem; color: var(--color-muted); }
  .predictive-search__all { text-decoration: underline; }
  .predictive-search [aria-selected='true'] > .predictive-search__link, .predictive-search__link:hover { background: var(--color-muted-background); }
{% endstylesheet %}

{% javascript %}
  // Whether the shopper is signed in comes from a cookie, which says nothing more (ADR-571).
  const signedIn = () => /(?:^|;\s*)hatti_signed_in=1(?:;|$)/.test(document.cookie);

  // The shopper's wishlist (OS-12, ADR-418): products' handles, newest first, kept in this
  // browser, since pages are the same for every shopper. The hearts on cards and product
  // pages add and remove them; the wishlist page and recently viewed read it through
  // window.HattiWishlist. Storage that cannot be read or written keeps nothing. Signed in, the
  // shopper's account keeps it too (ADR-575), so that it follows them to any browser they sign
  // in on: each heart pressed tells it, and this browser's list is still what pages show.
  const lists = (window.HattiWishlist = {
    read(key) {
      try {
        const kept = JSON.parse(localStorage.getItem(key) ?? '[]');
        return Array.isArray(kept) ? kept.filter((handle) => typeof handle === 'string') : [];
      } catch {
        return [];
      }
    },
    write(key, handles) {
      try {
        localStorage.setItem(key, JSON.stringify(handles));
      } catch {
        // Private browsing, or storage full: the list is not kept.
      }
    },
    handles() {
      return this.read('hatti:wishlist');
    },
    toggle(handle) {
      const handles = this.handles().filter((each) => each !== handle);
      const adding = handles.length === this.handles().length;
      this.write('hatti:wishlist', (adding ? [handle, ...handles] : handles).slice(0, 50));
      document.dispatchEvent(new CustomEvent('hatti:wishlist'));
      if (signedIn()) {
        if (adding) this.account('/account/wishlist', { handles: [handle] });
        else this.account('/account/wishlist/remove', { handle });
      }
      return adding;
    },
    /**
     * Tells the shopper's account of a change to their wishlist (ADR-575): its handles as it is
     * then, newest first; null if the account could not be reached, or they are not signed in.
     */
    async account(path, body) {
      try {
        const response = await fetch(path, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(body),
          credentials: 'same-origin',
        });
        if (!response.ok) return null;
        const { handles } = await response.json();
        return Array.isArray(handles) ? handles.filter((handle) => typeof handle === 'string') : null;
      } catch {
        return null;
      }
    },
    remove(handle) {
      if (this.handles().includes(handle)) this.toggle(handle);
    },
    /** Products viewed, newest first: at most 12. */
    viewed(handle) {
      const handles = this.read('hatti:viewed').filter((each) => each !== handle);
      if (handle) this.write('hatti:viewed', [handle, ...handles].slice(0, 12));
      return handles;
    },
    /** A product's card, as the theme renders it, for its handle; null once it is gone. */
    async card(handle) {
      // The root is "/", or "/ur" for the Urdu pages.
      const root = (document.querySelector('[data-root]')?.dataset.root ?? '/').replace(/\/$/, '');
      const url = `${root}/products/${encodeURIComponent(handle)}?section_id=product-card`;
      const response = await fetch(url).catch(() => null);
      if (!response?.ok) return null;
      const html = new DOMParser().parseFromString(await response.text(), 'text/html');
      return html.querySelector('.card');
    },
  });
  const showWishlist = () => {
    const handles = new Set(lists.handles());
    for (const button of document.querySelectorAll('[data-wishlist]')) {
      button.hidden = false;
      button.setAttribute('aria-pressed', String(handles.has(button.dataset.wishlist)));
    }
    for (const count of document.querySelectorAll('[data-wishlist-count]')) {
      count.textContent = String(handles.size);
      count.hidden = handles.size === 0;
    }
  };
  document.addEventListener('click', (event) => {
    const button = event.target.closest?.('[data-wishlist]');
    if (!button) return;
    lists.toggle(button.dataset.wishlist);
  });
  document.addEventListener('hatti:wishlist', showWishlist);
  // Cards added later, as recently viewed and the wishlist page add them.
  new MutationObserver(showWishlist).observe(document.body, { childList: true, subtree: true });
  showWishlist();

  // Signed in, once a visit (ADR-575): this browser's wishlist joins the account's, and the
  // account's, as it is then, becomes this browser's. Signed out, nothing is asked, and the next
  // sign-in joins them again.
  try {
    const joined = 'hatti:wishlist-joined';
    if (!signedIn()) {
      sessionStorage.removeItem(joined);
    } else if (!sessionStorage.getItem(joined)) {
      sessionStorage.setItem(joined, '1');
      lists.account('/account/wishlist', { handles: lists.handles() }).then((handles) => {
        try {
          // Not joined: the next page tries again.
          if (!handles) return sessionStorage.removeItem(joined);
          lists.write('hatti:wishlist', handles.slice(0, 50));
          document.dispatchEvent(new CustomEvent('hatti:wishlist'));
        } catch {
          // Storage that cannot be written keeps nothing.
        }
      });
    }
  } catch {
    // Storage that cannot be read or written keeps no list to join.
  }

  // Pages are the same for every shopper, so the cart's count comes from its cookie.
  const count = /(?:^|;\s*)cart_count=(\d+)/.exec(document.cookie);
  if (count) {
    for (const element of document.querySelectorAll('[data-cart-count]')) {
      element.textContent = count[1];
    }
  }

  // A signed-in reseller's own prices on cards (CUS-06, ADR-782): every card's variants asked
  // for together, a hundred at a time and each once a page; a card says the lowest of its
  // variants' where it is below the card's price. Signed out, nothing is asked.
  const ownPrices = new Map();
  const askedPrices = new Set();
  const showOwnPrices = () => {
    for (const card of document.querySelectorAll('[data-card-own-price]')) {
      let lowest = null;
      for (const pair of card.dataset.cardOwnPrice.split(',')) {
        const [id, price] = pair.split(':');
        const own = ownPrices.get(id);
        const amount = own ? own.amount : Number(price);
        if (lowest === null || amount < lowest.amount) lowest = own ?? { amount };
      }
      const words =
        lowest?.formatted && lowest.amount < Number(card.dataset.price)
          ? card.dataset.words.replace('{price}', lowest.formatted)
          : '';
      // Only what changed, so the page's observer is not woken for nothing.
      if (card.textContent !== words) card.textContent = words;
      card.hidden = words === '';
    }
  };
  const askOwnPrices = async () => {
    const ids = [...document.querySelectorAll('[data-card-own-price]')]
      .flatMap((card) => card.dataset.cardOwnPrice.split(',').map((pair) => pair.split(':')[0]))
      .filter((id) => id && !askedPrices.has(id));
    for (const id of ids) askedPrices.add(id);
    for (let start = 0; start < ids.length; start += 100) {
      try {
        const asked = encodeURIComponent(ids.slice(start, start + 100).join(','));
        const response = await fetch(`/account/prices.json?variants=${asked}`, {
          headers: { accept: 'application/json' },
          credentials: 'same-origin',
        });
        if (!response.ok) break;
        const { prices } = await response.json();
        for (const [id, price] of Object.entries(prices ?? {})) ownPrices.set(id, price);
      } catch {
        break;
      }
    }
    showOwnPrices();
  };
  if (signedIn()) {
    let pending = false;
    const later = () => {
      if (pending) return;
      pending = true;
      setTimeout(() => {
        pending = false;
        askOwnPrices();
      }, 50);
    };
    // Cards added later too, as recently viewed and the wishlist page add them.
    new MutationObserver(later).observe(document.body, { childList: true, subtree: true });
    askOwnPrices();
  }

  // Signed in, the header's link says "Account" (ADR-571).
  if (signedIn()) {
    for (const link of document.querySelectorAll('[data-account-link]')) {
      link.textContent = link.dataset.signedIn;
    }
  }

  // Suggestions as the shopper types (ADR-046): the theme's predictive-search section, asked for
  // what is in the box once typing pauses, and chosen with the arrow keys. Without scripts, the
  // box searches as a form.
  class HattiSearch extends HTMLElement {
    connectedCallback() {
      this.input = this.querySelector('input[type="search"]');
      this.results = this.querySelector('[data-results]');
      this.found = new Map();
      this.input.addEventListener('input', () => {
        clearTimeout(this.timer);
        this.timer = setTimeout(() => this.suggest(), 200);
      });
      this.input.addEventListener('keydown', (event) => this.key(event));
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget)) this.close();
      });
      const details = this.closest('details');
      details?.addEventListener('toggle', () => {
        if (details.open) this.input.focus();
      });
    }

    async suggest() {
      const terms = this.input.value.trim();
      if (terms === '') return this.close();
      let html = this.found.get(terms);
      if (html === undefined) {
        this.asking?.abort();
        this.asking = new AbortController();
        const query = new URLSearchParams({
          q: terms,
          section_id: 'predictive-search',
          'resources[type]': 'product,page,article',
          'resources[limit]': '4',
        });
        try {
          const response = await fetch(`${this.dataset.url}?${query}`, {
            signal: this.asking.signal,
          });
          if (!response.ok) return this.close();
          const page = new DOMParser().parseFromString(await response.text(), 'text/html');
          html = page.querySelector('.hatti-section')?.innerHTML ?? '';
          this.found.set(terms, html);
        } catch {
          return; // Asked again since, or offline: the box still searches as a form.
        }
      }
      if (this.input.value.trim() !== terms) return;
      this.results.innerHTML = html;
      this.results.hidden = html.trim() === '';
      this.input.setAttribute('aria-expanded', String(!this.results.hidden));
      this.input.removeAttribute('aria-activedescendant');
    }

    key(event) {
      if (event.key === 'Escape') {
        if (this.results.hidden) this.closest('details')?.removeAttribute('open');
        return this.close();
      }
      const options = [...this.results.querySelectorAll('[role="option"]')];
      if (this.results.hidden || options.length === 0) return;
      const current = options.findIndex((option) => option.getAttribute('aria-selected') === 'true');
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const next =
          current < 0
            ? (step > 0 ? 0 : options.length - 1)
            : (current + step + options.length) % options.length;
        options.forEach((option, index) => option.setAttribute('aria-selected', String(index === next)));
        this.input.setAttribute('aria-activedescendant', options[next].id);
        options[next].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && current >= 0) {
        event.preventDefault();
        options[current].querySelector('a')?.click();
      }
    }

    close() {
      this.results.hidden = true;
      this.input.setAttribute('aria-expanded', 'false');
      this.input.removeAttribute('aria-activedescendant');
    }
  }
  if (!customElements.get('hatti-search')) customElements.define('hatti-search', HattiSearch);
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "wishlist",
      "label": "t:sections.header.settings.wishlist.label",
      "info": "t:sections.header.settings.wishlist.info",
      "default": false
    }
  ]
}
{% endschema %}
