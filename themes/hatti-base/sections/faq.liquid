{%- comment -%}
  Questions shoppers ask, each with its answer, opened in place (OS-09, ADR-615); and, where the
  section says so, the same questions told to search engines as schema.org's FAQPage. Only the
  questions with an answer are given to either.
{%- endcomment -%}
{%- liquid
  assign answered = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign answered = answered | plus: 1
    endif
  endfor
-%}
{%- if answered > 0 -%}
<div class="page-width section-spacing faq">
  {%- if section.settings.heading != blank %}
  <h2 dir="auto">{{ section.settings.heading | escape }}</h2>
  {%- endif %}
  {%- for block in section.blocks %}
    {%- if block.settings.question != blank and block.settings.answer != blank %}
  <details class="faq__item" {{ block.shopify_attributes }}>
    <summary dir="auto">{{ block.settings.question | escape }}</summary>
    <div class="faq__answer" dir="auto">{{ block.settings.answer | escape | newline_to_br }}</div>
  </details>
    {%- endif %}
  {%- endfor %}
</div>
  {%- if section.settings.structured_data -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {%- assign first = true -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.question != blank and block.settings.answer != blank -%}
      {%- unless first %},{% endunless -%}
      {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | json }}}}
      {%- assign first = false -%}
    {%- endif -%}
  {%- endfor -%}
]}</script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .faq__item { border-block-end: 1px solid rgb(0 0 0 / 0.1); padding-block: 0.75rem; }
  .faq__item summary { cursor: pointer; font-weight: 600; }
  .faq__answer { margin-block-start: 0.5rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Questions and answers"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:sections.faq.settings.structured_data.label",
      "info": "t:sections.faq.settings.structured_data.info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "limit": 50,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.settings.question.label"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.settings.answer.label"
        }
      ]
    }
  ],
  "presets": [{"name": "t:sections.faq.name", "blocks": [{"type": "question"}]}]
}
{% endschema %}
