{%- comment -%}
  The cart's cross-sells (MKT-09, ADR-437): the products the shop pairs with what the cart holds,
  as Shopify's complementary recommendations. The page asks for those of each of its first three
  products, rendered by this section, and shows them together, in turn, without one the cart holds
  already or one twice, as many as the section's setting. Until then, and where there are none, it
  shows nothing. Asked for itself, it renders the products recommended alone.
{%- endcomment -%}
{%- if recommendations.performed? -%}
  {%- if recommendations.products_count > 0 -%}
    <ul class="grid" role="list">
      {%- for product in recommendations.products -%}
        <li class="grid__item" data-product-id="{{ product.id }}">
          {%- render 'card-product', product: product, position: forloop.index -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- elsif cart.item_count > 0 -%}
  {%- liquid
    assign in_cart = ''
    assign urls = ''
    assign asked = 0
    for item in cart.items
      assign id = item.product_id | append: ''
      unless in_cart contains id
        assign in_cart = in_cart | append: id | append: ' '
        if asked < 3
          assign asked = asked | plus: 1
          assign urls = urls | append: routes.product_recommendations_url | append: '?section_id=cart-upsells&intent=complementary&product_id=' | append: id | append: '&limit=' | append: section.settings.products_to_show | append: ' '
        endif
      endunless
    endfor
  -%}
  <hatti-cart-upsells
    class="page-width section-spacing"
    data-urls="{{ urls | strip }}"
    data-in-cart="{{ in_cart | strip }}"
    data-limit="{{ section.settings.products_to_show }}"
    hidden
  >
    {%- if section.settings.title != blank -%}
      <h2 dir="auto">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <ul class="grid" role="list"></ul>
  </hatti-cart-upsells>
{%- endif -%}

{% javascript %}
  class HattiCartUpsells extends HTMLElement {
    async connectedCallback() {
      const urls = (this.dataset.urls || '').split(' ').filter(Boolean);
      const held = new Set((this.dataset.inCart || '').split(' ').filter(Boolean));
      const limit = Number(this.dataset.limit) || 4;
      const pages = await Promise.all(
        urls.map(async (url) => {
          try {
            const response = await fetch(url);
            return response.ok ? await response.text() : '';
          } catch {
            return '';
          }
        }),
      );
      const list = this.querySelector('ul');
      const shown = new Set(held);
      for (const html of pages) {
        const page = new DOMParser().parseFromString(html, 'text/html');
        for (const item of page.querySelectorAll('li[data-product-id]')) {
          const id = item.getAttribute('data-product-id');
          if (!id || shown.has(id) || list.childElementCount >= limit) continue;
          shown.add(id);
          list.append(document.importNode(item, true));
        }
      }
      if (list.childElementCount > 0) this.hidden = false;
    }
  }
  if (!customElements.get('hatti-cart-upsells')) {
    customElements.define('hatti-cart-upsells', HattiCartUpsells);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.cart-upsells.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.cart-upsells.settings.title.label",
      "default": "Goes well with your order"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.cart-upsells.settings.products_to_show.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
