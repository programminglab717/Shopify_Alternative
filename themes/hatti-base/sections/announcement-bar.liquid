{%- if section.settings.text != blank -%}
  <p class="announcement" dir="auto">{{ section.settings.text | escape }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement-bar.settings.text.label",
      "default": "Cash on delivery across Pakistan"
    }
  ]
}
{% endschema %}
