{%- if section.settings.text != blank -%}
  {%- comment -%} A landmark of its own, for screen readers to find it by (ADR-967). {%- endcomment -%}
  <aside aria-label="{{ 'accessibility.announcement' | t | escape }}">
    <p class="announcement" dir="auto">{{ section.settings.text | escape }}</p>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement-bar.settings.text.label",
      "default": "Cash on delivery across Pakistan"
    }
  ]
}
{% endschema %}
