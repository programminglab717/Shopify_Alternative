<article class="page-width section-spacing article">
  {%- if blog -%}
    {%- assign title = blog.title | escape -%}
    <p><a href="{{ blog.url }}">{{ 'sections.article.back' | t: blog: title }}</a></p>
  {%- endif -%}
  <h1 dir="auto">{{ article.title | escape }}</h1>
  <p class="article__meta">
    <time datetime="{{ article.published_at }}">{{ article.published_at | date: '%-d %B %Y' }}</time>
    {%- if article.author != blank -%}
      {%- assign author = article.author | escape %} · {{ 'sections.article.by' | t: author: author }}
    {%- endif -%}
  </p>
  {%- comment -%} Cleaned when the shop saved it: text, links, images and tables, nothing that runs. {%- endcomment -%}
  <div class="rte" dir="auto">{{ article.content }}</div>
  {%- if article.tags.size > 0 -%}
    <p class="article__tags">
      {{ 'sections.article.tags' | t }}
      {%- for each in article.tags %}
        <a href="{{ blog.url }}/tagged/{{ each | handleize }}">{{ each | escape }}</a>
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    </p>
  {%- endif -%}
  {%- if blog.next_article or blog.previous_article -%}
    <nav class="article__nav" aria-label="{{ 'sections.article.more' | t: blog: title }}">
      {%- if blog.next_article -%}
        <a href="{{ blog.next_article.url }}" class="article__older">
          <span>{{ 'sections.article.older' | t }}</span>
          <span dir="auto">{{ blog.next_article.title | escape }}</span>
        </a>
      {%- endif -%}
      {%- if blog.previous_article -%}
        <a href="{{ blog.previous_article.url }}" class="article__newer">
          <span>{{ 'sections.article.newer' | t }}</span>
          <span dir="auto">{{ blog.previous_article.title | escape }}</span>
        </a>
      {%- endif -%}
    </nav>
  {%- endif -%}
</article>

{% stylesheet %}
  .article h1 { margin-block-end: 0.5rem; }
  .article__meta { margin-block: 0 1.5rem; opacity: 0.75; }
  .article .rte img { max-inline-size: 100%; block-size: auto; }
  .article__tags { margin-block-start: 2rem; }
  .article__nav { display: flex; gap: 1rem; justify-content: space-between; margin-block-start: 2rem; }
  .article__nav a { display: flex; flex-direction: column; }
  .article__nav a span:first-child { font-size: 0.875rem; opacity: 0.75; }
  .article__newer { margin-inline-start: auto; text-align: end; }
{% endstylesheet %}

{% schema %}
{ "name": "Article" }
{% endschema %}
