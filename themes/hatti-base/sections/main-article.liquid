<article class="page-width section-spacing article">
  {%- if blog -%}
    {%- assign title = blog.title | escape -%}
    <p><a href="{{ blog.url }}">{{ 'sections.article.back' | t: blog: title }}</a></p>
  {%- endif -%}
  <h1 dir="auto">{{ article.title | escape }}</h1>
  <p class="article__meta">
    {{ article.published_at | time_tag: format: 'day_month_year' }}
    {%- if article.author != blank -%}
      {%- assign author = article.author | escape %} · {{ 'sections.article.by' | t: author: author }}
    {%- endif -%}
  </p>
  {%- if article.image -%}
    <figure class="article__image">
      {{- article.image | image_url: width: 1200 | image_tag: widths: '1200', fetchpriority: 'high' -}}
    </figure>
  {%- endif -%}
  {%- comment -%} Cleaned when the shop saved it: text, links, images and tables, nothing that runs. {%- endcomment -%}
  <div class="rte" dir="auto">{{ article.content }}</div>
  {%- if article.tags.size > 0 -%}
    <p class="article__tags">
      {{ 'sections.article.tags' | t }}
      {%- for each in article.tags %}
        <a href="{{ blog.url }}/tagged/{{ each | handleize }}">{{ each | escape }}</a>
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    </p>
  {%- endif -%}
  {%- if blog.next_article or blog.previous_article -%}
    <nav class="article__nav" aria-label="{{ 'sections.article.more' | t: blog: title }}">
      {%- if blog.next_article -%}
        <a href="{{ blog.next_article.url }}" class="article__older">
          <span>{{ 'sections.article.older' | t }}</span>
          <span dir="auto">{{ blog.next_article.title | escape }}</span>
        </a>
      {%- endif -%}
      {%- if blog.previous_article -%}
        <a href="{{ blog.previous_article.url }}" class="article__newer">
          <span>{{ 'sections.article.newer' | t }}</span>
          <span dir="auto">{{ blog.previous_article.title | escape }}</span>
        </a>
      {%- endif -%}
    </nav>
  {%- endif -%}
  {%- comment -%}
    Comments, where the blog takes them (ADR-220): those the shop shows, escaped as text when they
    were published, and Shopify's new_comment form, which comes back here saying how it went.
  {%- endcomment -%}
  {%- if article.comments_enabled? -%}
    <section id="comments" class="article__comments" aria-labelledby="comments-heading">
      <h2 id="comments-heading">{{ 'sections.article.comments' | t: count: article.comments_count }}</h2>
      {%- paginate article.comments by 20 -%}
        {%- for comment in article.comments -%}
          <div id="comment-{{ comment.id }}" class="article__comment">
            <div class="rte" dir="auto">{{ comment.content }}</div>
            <p class="article__comment-meta">
              <span dir="auto">{{ comment.author | escape }}</span> ·
              {{ comment.created_at | time_tag: format: 'day_month_year' }}
            </p>
          </div>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <nav class="pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
      {%- form 'new_comment', article -%}
        <h3>{{ 'sections.article.comment_form' | t }}</h3>
        {%- if form.posted_successfully? -%}
          <p class="article__comment-status" role="status">
            {%- if article.moderated? -%}
              {{ 'sections.article.comment_moderated' | t }}
            {%- else -%}
              {{ 'sections.article.comment_posted' | t }}
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <p id="comment-error" class="article__comment-error" role="alert">{{ 'sections.article.comment_error' | t }}</p>
        {%- endif -%}
        <label for="comment-author">{{ 'sections.article.comment_author' | t }}</label>
        <input id="comment-author" type="text" name="comment[author]" autocomplete="name" maxlength="255" required>
        <label for="comment-email">{{ 'sections.article.comment_email' | t }}</label>
        <input id="comment-email" type="email" name="comment[email]" autocomplete="email" maxlength="254" dir="ltr" required>
        <label for="comment-body">{{ 'sections.article.comment_body' | t }}</label>
        <textarea id="comment-body" name="comment[body]" rows="5" maxlength="5000" dir="auto" required></textarea>
        {%- if article.moderated? -%}
          <p class="article__comment-note">{{ 'sections.article.comment_note' | t }}</p>
        {%- endif -%}
        <button type="submit" class="button">{{ 'sections.article.comment_submit' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% stylesheet %}
  .article h1 { margin-block-end: 0.5rem; }
  .article__meta { margin-block: 0 1.5rem; opacity: 0.75; }
  .article .rte img { max-inline-size: 100%; block-size: auto; }
  .article__image { margin: 0 0 1.5rem; }
  .article__image img { inline-size: 100%; block-size: auto; border-radius: 0.5rem; }
  .article__tags { margin-block-start: 2rem; }
  .article__nav { display: flex; gap: 1rem; justify-content: space-between; margin-block-start: 2rem; }
  .article__nav a { display: flex; flex-direction: column; }
  .article__nav a span:first-child { font-size: 0.875rem; opacity: 0.75; }
  .article__newer { margin-inline-start: auto; text-align: end; }
  .article__comments { margin-block-start: 3rem; }
  .article__comment { padding-block: 1rem; border-block-end: 1px solid var(--color-border); }
  .article__comment-meta { margin-block: 0.5rem 0; font-size: 0.875rem; opacity: 0.75; }
  .comment-form { display: grid; gap: 0.5rem; max-inline-size: 36rem; margin-block-start: 2rem; }
  .comment-form input, .comment-form textarea { padding: 0.6rem 0.75rem; font: inherit; }
  .comment-form .button { justify-self: start; }
  .article__comment-error { color: #b91c1c; margin: 0; }
  .article__comment-note, .article__comment-status { margin: 0; }
{% endstylesheet %}

{% schema %}
{ "name": "Article" }
{% endschema %}
