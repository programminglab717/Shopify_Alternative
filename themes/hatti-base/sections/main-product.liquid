{%- assign current = product.selected_or_first_available_variant -%}
<div class="page-width section-spacing product">
  <ul class="product__media" role="list">
    {%- for media in product.media -%}
      {%- liquid
        if forloop.first
          assign loading = 'eager'
          assign priority = 'high'
        else
          assign loading = 'lazy'
          assign priority = 'auto'
        endif
        assign alt = media.alt | default: product.title
      -%}
      <li>
        {%- case media.media_type -%}
          {%- when 'video' -%}
            {{ media | video_tag: image_size: '1100x', alt: alt }}
          {%- when 'external_video' -%}
            <div class="product__embed" style="--ratio: {{ media.aspect_ratio }}">
              {{ media | external_video_url | external_video_tag: title: alt, loading: loading }}
            </div>
          {%- else -%}
            {{
              media
              | image_url: width: 1100
              | image_tag:
                widths: '375, 550, 750, 1100',
                sizes: '(min-width: 990px) 55vw, 100vw',
                loading: loading,
                fetchpriority: priority,
                alt: alt
            }}
        {%- endcase -%}
      </li>
    {%- endfor -%}
  </ul>

  <div class="product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          <div {{ block.shopify_attributes }}>
            <div class="product__heading">
              <h1 class="product__title" dir="auto">{{ product.title | escape }}</h1>
              {% render 'wishlist-button', product: product %}
            </div>
            {%- if product.vendor != blank -%}<p class="product__vendor" dir="auto">{{ product.vendor | escape }}</p>{%- endif -%}
            {%- comment -%}
              How shoppers choose a suit (ADR-477): stitched or not, its pieces, fabrics and
              season, in the page's language.
            {%- endcomment -%}
            {%- if product.eastern_wear -%}<p class="product__eastern-wear" dir="auto">{{ product.eastern_wear.summary | escape }}</p>{%- endif -%}
            {% render 'rating', product: product, link: true %}
          </div>

        {%- when 'price' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'price', product: product, variant: current %}
            {%- comment -%}
              A signed-in reseller's own price (CUS-06, ADR-781), where their price list makes it
              lower: the page is the same for every shopper, so its script asks once it loads.
            {%- endcomment -%}
            <p class="product__own-price" data-own-price data-words="{{ 'products.product.price.yours' | t: price: '{price}' | escape }}" hidden></p>
            {%- comment -%}
              The sale it is in now (ADR-445): when it ends, counted down by the second where
              JavaScript runs, and said as a day where it does not. Gone once it ends.
            {%- endcomment -%}
            {%- if product.sale_ends_at -%}
              {%- assign ends_on = product.sale_ends_at | date: format: 'day_month_year' -%}
              <p
                class="product__sale-ends"
                data-sale-ends="{{ product.sale_ends_at }}"
                data-words="{{ 'products.product.sale_ends_in' | t: time: '{time}' | escape }}"
                data-days="{{ 'products.product.sale_days' | t: count: '{count}' | escape }}"
              >
                {{- 'products.product.sale_ends_on' | t: date: ends_on -}}
              </p>
            {%- endif -%}
          </div>

        {%- when 'buy_buttons' -%}
          <div class="product__buy" {{ block.shopify_attributes }}>
          {% render 'combined-listing', listing: product.combined_listing %}
          {% render 'bundle-contents', bundle: product.bundle %}
          {%- form 'product', product, id: 'product-form', class: 'product__form', novalidate: 'novalidate' -%}
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <fieldset class="product__option">
                  <legend>{{ option.name | escape }}</legend>
                  {%- for value in option.values -%}
                    <label class="pill">
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        {% if value == option.selected_value %}checked{% endif %}
                      >
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- endfor -%}
            {%- endunless -%}
            <label class="product__variants">
              <span>{{ 'products.product.variant' | t }}</span>
              <select name="id">
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant.id == current.id %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title | escape }} · {{ variant.price | money }}
                    {%- unless variant.available %} · {{ 'products.product.sold_out' | t }}{% endunless -%}
                  </option>
                {%- endfor -%}
              </select>
            </label>
            {% render 'personalisation-fields', fields: product.personalisation_fields %}
            {% render 'stitching', stitching: product.stitching %}
            {% render 'selling-plans', product: product %}
            <label class="product__quantity">
              <span>{{ 'products.product.quantity' | t }}</span>
              <input type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric">
            </label>
            <p class="product__error" role="alert" data-cart-error hidden></p>
            {%- comment -%}
              A drop still to start (ADR-823): its start counted down by the second, the button
              off until then where JavaScript runs; how many a customer may buy while it is live.
              The cart refuses it before then all the same.
            {%- endcomment -%}
            {%- if product.drop -%}
              {%- assign drop_starts = product.drop.starts_at | date: format: 'day_month_year' -%}
              <p
                class="product__drop"
                data-drop-starts="{{ product.drop.starts_at }}"
                data-drop-ends="{{ product.drop.ends_at }}"
                data-words="{{ 'products.product.drop_starts_in' | t: time: '{time}' | escape }}"
                data-days="{{ 'products.product.sale_days' | t: count: '{count}' | escape }}"
              >
                {{- 'products.product.drop_starts_on' | t: date: drop_starts -}}
              </p>
              {%- if product.drop.per_customer_limit -%}
                <p class="product__drop-limit">
                  {{- 'products.product.drop_limit' | t: count: product.drop.per_customer_limit -}}
                </p>
              {%- endif -%}
            {%- endif -%}
            <button type="submit" name="add" class="button" {% unless current.available %}disabled{% endunless %}>
              {%- if current.available and product.preorder_ships_on -%}
                {{ 'products.product.preorder' | t }}
              {%- elsif current.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
            {%- comment -%} Orders paused (ADR-622): it goes in the cart for when they come back. {%- endcomment -%}
            {%- if shop.checkout_paused and current.available -%}
              <p class="product__paused" data-checkout-paused>{{ 'general.checkout_paused.product' | t }}</p>
            {%- endif -%}
            {%- comment -%}
              How many are left, where few are (ADR-445): the store says it only for 5 or fewer, so
              the words are never a guess. Picking another variant says its own.
            {%- endcomment -%}
            <p
              class="product__low-stock"
              data-low-stock
              data-words="{{ 'products.product.low_stock' | t: count: '{count}' | escape }}"
              {% unless current.inventory_quantity > 0 %}hidden{% endunless %}
            >
              {%- if current.inventory_quantity > 0 -%}
                {{- 'products.product.low_stock' | t: count: current.inventory_quantity -}}
              {%- endif -%}
            </p>
            {%- if product.preorder_ships_on -%}
              {%- assign ships_on = product.preorder_ships_on | date: format: 'day_month_year' -%}
              <p class="product__preorder">{{ 'products.product.preorder_ships' | t: date: ships_on }}</p>
            {%- endif -%}
          {%- endform -%}
          {%- comment -%}
            Back in stock (ADR-431): while the shop's automation is on, a sold-out variant's page
            asks for the shopper's mobile number, to tell them once on WhatsApp when it is back.
            Picking another variant shows it, or hides it, as that one sells or not.
          {%- endcomment -%}
          {%- if shop.back_in_stock -%}
            {%- liquid
              assign back = request.path
              if routes.root_url != '/'
                assign back = routes.root_url | append: request.path
              endif
            -%}
            <div class="back-in-stock" data-back-in-stock {% if current.available %}hidden{% endif %}>
              {%- form 'back_in_stock', id: 'back-in-stock', class: 'back-in-stock__form' -%}
                {%- if form.posted_successfully? -%}
                  <p role="status">{{ 'products.product.back_in_stock.success' | t }}</p>
                {%- else -%}
                  <input type="hidden" name="contact[variant_id]" value="{{ current.id }}">
                  <input type="hidden" name="return_to" value="{{ back | escape }}?variant={{ current.id }}#back-in-stock">
                  <label class="back-in-stock__label" for="back-in-stock-phone">
                    {{- 'products.product.back_in_stock.label' | t -}}
                  </label>
                  <div class="back-in-stock__fields">
                    <input
                      id="back-in-stock-phone"
                      type="tel"
                      name="contact[phone]"
                      autocomplete="tel"
                      inputmode="tel"
                      dir="ltr"
                      required
                      placeholder="0300 1234567"
                      aria-label="{{ 'products.product.back_in_stock.phone' | t }}"
                      {%- if form.errors %} aria-invalid="true" aria-describedby="back-in-stock-error"{% endif %}
                    >
                    <button type="submit" class="button button--secondary">{{ 'products.product.back_in_stock.submit' | t }}</button>
                  </div>
                  {%- if form.errors -%}
                    <p id="back-in-stock-error" class="back-in-stock__error" role="alert">
                      {%- if form.errors contains 'phone' -%}
                        {{ 'products.product.back_in_stock.phone_error' | t }}
                      {%- else -%}
                        {{ 'products.product.back_in_stock.error' | t }}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}
          {% render 'size-chart', chart: product.size_chart, id: product.id %}
          {%- if settings.whatsapp_orders and shop.whatsapp -%}
            {%- comment -%}
              The message names the product, the variant picked and its link (ADR-593), and the
              script below keeps it to the variant picked.
            {%- endcomment -%}
            {%- liquid
              assign template = ''
              if product.has_only_default_variant
                assign message = 'general.whatsapp.order_product_message' | t: product: product.title, url: canonical_url
              else
                assign link = canonical_url | append: '?variant=' | append: current.id
                assign message = 'general.whatsapp.order_message' | t: product: product.title, variant: current.title, url: link
                assign link = canonical_url | append: '?variant=__ID__'
                assign words = 'general.whatsapp.order_message' | t: product: product.title, variant: '__VARIANT__', url: link
                assign template = shop.whatsapp | whatsapp_url: words
              endif
            -%}
            <a
              class="button button--secondary"
              href="{{ shop.whatsapp | whatsapp_url: message }}"
              {%- if template != blank %} data-whatsapp-template="{{ template }}"{% endif %}
            >
              {{- 'general.whatsapp.order' | t -}}
            </a>
          {%- endif -%}
          </div>

        {%- when 'delivery' -%}
          <ul class="product__promises" role="list" {{ block.shopify_attributes }}>
            {%- if cod.available -%}
              <li>
                {%- if cod.fee > 0 -%}
                  {%- assign fee = cod.fee | money -%}
                  {{ 'products.product.cod_fee' | t: fee: fee }}
                {%- else -%}
                  {{ 'products.product.cod' | t }}
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if delivery.max_days != nil -%}
              <li>{% render 'delivery-days', min: delivery.min_days, max: delivery.max_days %}</li>
            {%- else -%}
              <li>{{ 'products.product.delivery' | t }}</li>
            {%- endif -%}
            {%- liquid
              assign lowest = delivery.charge
              for zone in delivery.zones
                if zone.charge < lowest
                  assign lowest = zone.charge
                endif
              endfor
            -%}
            {%- if delivery.free_above -%}
              {%- assign from = delivery.free_above | money -%}
              <li>{{ 'products.product.free_delivery_from' | t: amount: from }}</li>
            {%- elsif lowest > 0 -%}
              {%- assign from = lowest | money -%}
              <li>{{ 'products.product.delivery_from' | t: amount: from }}</li>
            {%- endif -%}
            {%- comment -%} What heavier orders cost more to deliver (ADR-704). {%- endcomment -%}
            {%- for weight in delivery.weights -%}
              {%- assign more = weight.charge | money -%}
              <li>{{ 'products.product.heavier' | t: weight: weight.above_kg, amount: more }}</li>
            {%- endfor -%}
            {%- comment -%} What larger orders pay at most to deliver (ADR-723). {%- endcomment -%}
            {%- for rate in delivery.value_rates -%}
              {%- assign from = rate.from_subtotal | money -%}
              {%- if rate.charge > 0 -%}
                {%- assign most = rate.charge | money -%}
                <li>{{ 'products.product.larger' | t: from: from, amount: most }}</li>
              {%- else -%}
                <li>{{ 'products.product.larger_free' | t: from: from }}</li>
              {%- endif -%}
            {%- endfor -%}
            {%- comment -%}
              What delivery to their own city costs and takes (OS-11, ADR-454): each of the shop's
              zones, with its cities, then everywhere else. Shown once a shopper asks.
            {%- endcomment -%}
            {%- if delivery.zones.size > 0 -%}
              <li>
                <details class="product__cities">
                  <summary>{{ 'products.product.delivery_by_city' | t }}</summary>
                  <ul role="list">
                    {%- for zone in delivery.zones -%}
                      <li>
                        <strong dir="auto">{{ zone.cities | join: ', ' }}</strong>:
                        {% if zone.charge > 0 %}{{ zone.charge | money }}{% else %}{{ 'products.product.free' | t }}{% endif -%}
                        {%- if zone.max_days != nil %} · {% render 'delivery-days', min: zone.min_days, max: zone.max_days %}{% endif %}
                      </li>
                    {%- endfor -%}
                    <li>
                      <strong>{{ 'products.product.elsewhere' | t }}</strong>:
                      {% if delivery.charge > 0 %}{{ delivery.charge | money }}{% else %}{{ 'products.product.free' | t }}{% endif -%}
                      {%- if delivery.everywhere_max_days != nil %} · {% render 'delivery-days', min: delivery.everywhere_min_days, max: delivery.everywhere_max_days %}{% endif %}
                    </li>
                  </ul>
                </details>
              </li>
            {%- endif -%}
            {%- comment -%}
              What the shop says of returns (OS-11, ADR-468): its window, none, or nothing said;
              and what its refund policy says, a tap away.
            {%- endcomment -%}
            {%- if shop.returns -%}
              <li class="product__returns">
                {%- if shop.returns.days == 0 -%}
                  {{ 'products.product.returns_none' | t }}
                {%- elsif shop.returns.exchanges_only -%}
                  {{ 'products.product.exchanges_within' | t: count: shop.returns.days }}
                {%- else -%}
                  {{ 'products.product.returns_within' | t: count: shop.returns.days }}
                {%- endif -%}
                {%- if shop.refund_policy %} · <a href="{{ shop.refund_policy.url }}">{{ 'products.product.returns_policy' | t }}</a>{% endif -%}
              </li>
            {%- elsif shop.refund_policy -%}
              <li>
                <a href="{{ shop.refund_policy.url }}">{{ 'products.product.returns' | t }}</a>
              </li>
            {%- endif -%}
            {%- comment -%}
              Hatti's word for who runs the shop (OS-11, ADR-466): its owner's CNIC checked, or
              its business registered too.
            {%- endcomment -%}
            {%- if shop.verified -%}
              <li class="product__verified">
                {% if shop.verified == 'business' %}{{ 'products.product.verified_business' | t }}{% else %}{{ 'products.product.verified_identity' | t }}{% endif %}
              </li>
            {%- endif -%}
          </ul>

        {%- when 'description' -%}
          <div class="product__description rte" dir="auto" {{ block.shopify_attributes }}>{{ product.description }}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>
{%- comment -%}
  What customers who received it said (ADR-401): the latest published reviews, each with its
  stars, its author's first name and initial, and when.
{%- endcomment -%}
{%- if product.reviews.size > 0 -%}
  <section id="reviews" class="page-width reviews" aria-labelledby="reviews-heading">
    <h2 id="reviews-heading">{{ 'products.product.reviews' | t }}</h2>
    {% render 'rating', product: product %}
    {%- for review in product.reviews -%}
      <article class="review">
        <p class="review__meta">
          <span class="rating__stars" aria-hidden="true" style="--rating: {{ review.rating }}">★★★★★</span>
          <span class="visually-hidden">{{ 'products.product.rating' | t: rating: review.rating }}</span>
          <span dir="auto">{{ review.author | escape }}</span> ·
          {{ review.created_at | time_tag: format: 'day_month_year' }}
        </p>
        {%- if review.content != blank -%}<div class="rte" dir="auto">{{ review.content }}</div>{%- endif -%}
        <p class="review__verified">{{ 'products.product.verified_buyer' | t }}</p>
      </article>
    {%- endfor -%}
  </section>
{%- endif -%}
<script type="application/json" data-variants>{{ product.variants | json }}</script>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% stylesheet %}
  .product { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .product__buy > .button { display: block; inline-size: 100%; }
  .product__media { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; gap: 0.5rem; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0; padding: 0; list-style: none; }
  .product__media li { scroll-snap-align: start; }
  .product__media img, .product__media video { inline-size: 100%; block-size: auto; }
  .product__embed { aspect-ratio: var(--ratio, 16 / 9); }
  .product__embed iframe { inline-size: 100%; block-size: 100%; border: 0; }
  .product__title { margin: 0; font-size: 1.75rem; }
  .product__heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; }
  .product__vendor { color: var(--color-muted); }
  .product__eastern-wear { margin-block: 0.25rem 0; font-size: 0.9375rem; }
  .product__form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-block: 1rem; }
  .product__option { display: flex; flex-wrap: wrap; gap: 0.5rem; min-inline-size: 0; border: 0; margin: 0; padding: 0; }
  .product__option legend { margin-block-end: 0.5rem; font-weight: 600; }
  .pill input { position: absolute; opacity: 0; }
  .pill span { display: inline-block; min-inline-size: 2.75rem; padding: 0.625rem 0.875rem; border: 1px solid var(--color-border); border-radius: 2rem; text-align: center; }
  .pill input:checked + span { border-color: var(--color-text); background: var(--color-text); color: var(--color-background); }
  .pill input:focus-visible + span { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .product__variants, .product__quantity, .product__personalisation { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.25rem; }
  .product__selling-plans { display: flex; flex-wrap: wrap; gap: 0.5rem; min-inline-size: 0; border: 0; margin: 0; padding: 0; }
  .product__selling-plans legend { margin-block-end: 0.5rem; font-weight: 600; }
  .product__selling-plans-note { flex-basis: 100%; margin: 0; opacity: 0.8; }
  .product__stitching { display: grid; gap: 0.75rem; min-inline-size: 0; border: 0; margin: 0; padding: 0; }
  .product__stitching legend { margin-block-end: 0.5rem; font-weight: 600; }
  .product__stitching-choices { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .product__measurements { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.75rem; }
  .product__measurements > p { grid-column: 1 / -1; margin: 0; color: var(--color-muted); }
  .product__stitching:has(input[value="Unstitched"]:checked) .product__measurements { display: none; }
  .product__promises { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .product__promises li::before { content: "✓ "; color: var(--color-accent); }
  .product__verified { font-weight: 600; }
  .product__sale-ends { margin: 0.25rem 0 0; color: var(--color-accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .product__drop { margin: 0 0 0.5rem; color: var(--color-accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .product__drop-limit { margin: 0 0 0.5rem; }
  .product__low-stock { margin: 0; color: #b45309; font-weight: 600; }
  .product__own-price { margin: 0.25rem 0 0; color: var(--color-accent); font-weight: 600; }
  .back-in-stock__form { display: grid; gap: 0.5rem; margin-block-end: 1rem; }
  .back-in-stock__label { font-weight: 600; }
  .back-in-stock__fields { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .back-in-stock__fields input { flex: 1 1 12rem; padding: 0.6rem 0.75rem; font: inherit; }
  .back-in-stock__error { color: #b91c1c; margin: 0; }
  .reviews { display: grid; gap: 1rem; margin-block-end: 2rem; }
  .reviews h2 { margin: 0; }
  .review { display: grid; gap: 0.25rem; padding-block-end: 1rem; border-block-end: 1px solid var(--color-border); }
  .review__meta, .review__verified { margin: 0; color: var(--color-muted); font-size: 0.875rem; }
  @media (min-width: 990px) {
    .product { grid-template-columns: minmax(0, 55fr) minmax(0, 45fr); align-items: start; }
    .product__media { grid-auto-flow: row; overflow: visible; }
  }
{% endstylesheet %}

{% javascript %}
  // With the options picked, the matching variant goes in the form; without JavaScript, the list does.
  const form = document.getElementById('product-form');
  const variants = JSON.parse(document.querySelector('[data-variants]')?.textContent ?? '[]');
  // A plan for chosen variants (ADR-930) shows for those alone: picked on another, it is bought once.
  function showPlans(variant) {
    const sold = new Set((variant.selling_plan_allocations ?? []).map((each) => each.selling_plan_id));
    for (const label of document.querySelectorAll('[data-selling-plan]')) {
      label.hidden = !sold.has(label.dataset.sellingPlan);
      const input = label.querySelector('input');
      if (label.hidden && input?.checked) {
        input.checked = false;
        form.querySelector('input[name="selling_plan"][value=""]').checked = true;
      }
    }
  }
  form?.addEventListener('change', (event) => {
    if (event.target.name === 'id') {
      const chosen = variants.find((each) => String(each.id) === event.target.value);
      if (chosen) showPlans(chosen);
      return;
    }
    if (!event.target.name?.startsWith('option-')) return;
    const picked = [...form.querySelectorAll('fieldset')].map((set) => set.querySelector('input:checked')?.value);
    const variant = variants.find((each) => each.options.every((value, index) => value === picked[index]));
    if (!variant) return;
    form.elements.id.value = variant.id;
    showOwnPrice(variant.id);
    showPlans(variant);
    // WhatsApp's messages name the variant picked, and link to it.
    for (const link of document.querySelectorAll('[data-whatsapp-template]')) {
      link.href = link.dataset.whatsappTemplate
        .replace('__VARIANT__', encodeURIComponent(variant.title))
        .replace('__ID__', variant.id);
    }
    // Its own stock's words, where few are left.
    const low = document.querySelector('[data-low-stock]');
    if (low) {
      low.hidden = !(variant.inventory_quantity > 0);
      low.textContent = low.hidden ? '' : low.dataset.words.replace('{count}', variant.inventory_quantity);
    }
    // A sold-out variant's page asks to tell the shopper when it is back; another variant's not.
    const wish = document.querySelector('[data-back-in-stock]');
    const fields = wish?.querySelector('form')?.elements;
    if (!wish || !fields?.['contact[variant_id]']) return;
    wish.hidden = variant.available;
    fields['contact[variant_id]'].value = variant.id;
    fields.return_to.value = fields.return_to.value.replace(/variant=[^#&]+/, `variant=${variant.id}`);
  });

  // A signed-in shopper's own prices (ADR-781), those their price list makes lower, asked for
  // once the page loads; signed out, nothing is asked and nothing shown.
  const ownPrice = document.querySelector('[data-own-price]');
  let ownPrices = {};
  function showOwnPrice(variantId) {
    if (!ownPrice) return;
    const price = ownPrices[variantId];
    ownPrice.hidden = !price;
    ownPrice.textContent = price ? ownPrice.dataset.words.replace('{price}', price.formatted) : '';
  }
  if (ownPrice && variants.length > 0 && /(?:^|;\s*)hatti_signed_in=1(?:;|$)/.test(document.cookie)) {
    const ids = variants.map((variant) => variant.id).slice(0, 100).join(',');
    fetch(`/account/prices.json?variants=${encodeURIComponent(ids)}`, {
      headers: { accept: 'application/json' },
      credentials: 'same-origin',
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((body) => {
        if (!body || typeof body.prices !== 'object') return;
        ownPrices = body.prices;
        showOwnPrice(form?.elements.id.value);
      })
      .catch(() => {});
  }

  // A drop's start counted down by the second (ADR-823), the button off until it comes; gone once
  // it starts, the button on again where its variant is for sale.
  for (const drop of document.querySelectorAll('[data-drop-starts]')) {
    const starts = Date.parse(drop.dataset.dropStarts);
    const ends = Date.parse(drop.dataset.dropEnds);
    const button = drop.closest('form')?.querySelector('button[name="add"]');
    const wasOn = button && !button.disabled;
    const pad = (value) => String(value).padStart(2, '0');
    const tick = () => {
      const seconds = Math.floor((starts - Date.now()) / 1000);
      if (!(seconds > 0)) {
        drop.hidden = true;
        if (button && wasOn && Date.now() < ends) button.disabled = false;
        clearInterval(timer);
        return;
      }
      if (button) button.disabled = true;
      const days = Math.floor(seconds / 86400);
      const clock = `${pad(Math.floor((seconds % 86400) / 3600))}:${pad(Math.floor((seconds % 3600) / 60))}:${pad(seconds % 60)}`;
      const time = days > 0 ? `${drop.dataset.days.replace('{count}', days)} ${clock}` : clock;
      drop.textContent = drop.dataset.words.replace('{time}', time);
    };
    const timer = setInterval(tick, 1000);
    tick();
  }

  // A sale's end counted down by the second (ADR-445); gone once it ends.
  for (const sale of document.querySelectorAll('[data-sale-ends]')) {
    const ends = Date.parse(sale.dataset.saleEnds);
    const pad = (value) => String(value).padStart(2, '0');
    const tick = () => {
      const seconds = Math.floor((ends - Date.now()) / 1000);
      if (!(seconds > 0)) {
        sale.hidden = true;
        clearInterval(timer);
        return;
      }
      const days = Math.floor(seconds / 86400);
      const clock = `${pad(Math.floor((seconds % 86400) / 3600))}:${pad(Math.floor((seconds % 3600) / 60))}:${pad(seconds % 60)}`;
      const time = days > 0 ? `${sale.dataset.days.replace('{count}', days)} ${clock}` : clock;
      sale.textContent = sale.dataset.words.replace('{time}', time);
    };
    const timer = setInterval(tick, 1000);
    tick();
  }
