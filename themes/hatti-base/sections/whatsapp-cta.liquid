{%- if shop.whatsapp -%}
  <div class="page-width section-spacing whatsapp-cta">
    <h2 dir="auto">{{ section.settings.heading | escape }}</h2>
    <p dir="auto">{{ section.settings.text | escape }}</p>
    <a class="button button--whatsapp" href="{{ shop.whatsapp | whatsapp_url: section.settings.message }}">
      {{- 'general.whatsapp.chat' | t -}}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  .whatsapp-cta { text-align: center; }
  .button--whatsapp { background: #128C7E; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.whatsapp-cta.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.whatsapp-cta.settings.heading.label",
      "default": "Questions? Ask us on WhatsApp"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.whatsapp-cta.settings.text.label",
      "default": "Sizes, colours, delivery: we reply within the hour."
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:sections.whatsapp-cta.settings.message.label",
      "default": "Hi! I have a question."
    }
  ]
}
{% endschema %}
