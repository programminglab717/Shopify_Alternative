{%- comment -%}
  A YouTube or Vimeo video the shop chose, with a heading above it and a few words beneath (OS-08,
  ADR-705): played in its place, loaded as the page scrolls to it. Nothing without a video.
{%- endcomment -%}
{%- assign video = section.settings.video -%}
{%- if video -%}
<div class="page-width section-spacing video-section">
  {%- if section.settings.heading != blank %}
  <h2 dir="auto">{{ section.settings.heading | escape }}</h2>
  {%- endif %}
  <div class="video-section__frame">
    {{ video | external_video_tag: title: section.settings.heading }}
  </div>
  {%- if section.settings.text != blank %}
  <p class="video-section__text" dir="auto">{{ section.settings.text | escape | newline_to_br }}</p>
  {%- endif %}
</div>
{%- endif -%}

{% stylesheet %}
  .video-section__frame { position: relative; aspect-ratio: 16 / 9; background: var(--color-muted-background); }
  .video-section__frame iframe { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; border: 0; }
  .video-section__text { margin-block-start: 0.75rem; max-inline-size: 42rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.video.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "video_url",
      "id": "video",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video.settings.video.label",
      "info": "t:sections.video.settings.video.info"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.video.settings.text.label"
    }
  ],
  "presets": [{"name": "t:sections.video.name"}]
}
{% endschema %}
