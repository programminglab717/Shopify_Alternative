{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="page-width section-spacing">
    <div class="section-title">
      <h1 dir="auto">{{ collection.title | escape }}</h1>
      <p>{{ 'sections.collection.count' | t: count: collection.products_count }}</p>
    </div>
    {%- if collection.description != blank -%}
      <div class="rte" dir="auto">{{ collection.description }}</div>
    {%- endif -%}
    <ul class="grid" role="list">
      {%- for product in collection.products -%}
        <li class="grid__item">{% render 'card-product', product: product, position: forloop.index %}</li>
      {%- else -%}
        <li>{{ 'sections.collection.empty' | t }}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
