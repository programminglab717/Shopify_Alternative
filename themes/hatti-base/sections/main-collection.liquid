{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="page-width section-spacing">
    <div class="section-title">
      <h1 dir="auto">{{ collection.title | escape }}</h1>
      <p>{{ 'sections.collection.count' | t: count: collection.products_count }}</p>
    </div>
    {%- if collection.description != blank -%}
      <div class="rte" dir="auto">{{ collection.description }}</div>
    {%- endif -%}
    {%- if collection.filters.size > 0 -%}
      {%- liquid
        assign active_count = 0
        for filter in collection.filters
          if filter.type == 'price_range'
            if filter.min_value.value != nil or filter.max_value.value != nil
              assign active_count = active_count | plus: 1
            endif
          else
            assign active_count = active_count | plus: filter.active_values.size
          endif
        endfor
      -%}
      <details class="facets"{% if active_count > 0 %} open{% endif %}>
        <summary>{{ 'sections.collection.filters.title' | t }}</summary>
        <form class="facets__form" action="{{ collection.url }}" method="get">
          {%- for filter in collection.filters -%}
            <fieldset class="facets__filter">
              <legend dir="auto">{{ filter.label | escape }}</legend>
              {%- if filter.type == 'price_range' -%}
                <label>
                  {{ 'sections.collection.filters.from' | t }}
                  <input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100 }}" inputmode="numeric"{% if filter.min_value.value != nil %} value="{{ filter.min_value.value | divided_by: 100 }}"{% endif %}>
                </label>
                <label>
                  {{ 'sections.collection.filters.to' | t }}
                  <input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100 }}" inputmode="numeric" placeholder="{{ filter.range_max | divided_by: 100 }}"{% if filter.max_value.value != nil %} value="{{ filter.max_value.value | divided_by: 100 }}"{% endif %}>
                </label>
              {%- else -%}
                {%- for value in filter.values -%}
                  <label class="facets__value{% if value.count == 0 and value.active == false %} facets__value--none{% endif %}">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                    <span dir="auto">{{ value.label | escape }}</span> <span class="facets__count">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              {%- endif -%}
            </fieldset>
          {%- endfor -%}
          <button type="submit" class="button">{{ 'sections.collection.filters.apply' | t }}</button>
        </form>
      </details>
      {%- if active_count > 0 -%}
        <ul class="facets__active" role="list">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <li><a href="{{ filter.url_to_remove }}" aria-label="{{ 'sections.collection.filters.remove' | t: name: filter.label }}">{{ filter.label | escape }}: {{ filter.min_value.value | default: 0 | money }} – {% if filter.max_value.value != nil %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %} ✕</a></li>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                <li><a href="{{ value.url_to_remove }}" aria-label="{{ 'sections.collection.filters.remove' | t: name: value.label }}" dir="auto">{{ value.label | escape }} ✕</a></li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a href="{{ collection.url }}">{{ 'sections.collection.filters.clear' | t }}</a></li>
        </ul>
      {%- endif -%}
    {%- endif -%}
    <ul class="grid" role="list">
      {%- for product in collection.products -%}
        <li class="grid__item">{% render 'card-product', product: product, position: forloop.index %}</li>
      {%- else -%}
        <li>{{ 'sections.collection.empty' | t }}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-collection.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main-collection.settings.products_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
