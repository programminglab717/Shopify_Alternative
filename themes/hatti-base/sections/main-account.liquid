{%- comment -%}
  The shopper's account (CUS-02, ADR-571): their orders with the shop, the newest first, each
  opening its page while it has one, and their store credit. The storefront shows it only to a
  signed-in shopper, and sends others to sign in; in the theme editor, there is no one. Each
  order lists what it sold, and while any of it can be had, "Buy again" puts it in the cart
  (ADR-574), which says what could not go. Under
  "Your data" (CUS-05, ADR-572), they download the file of their own data, or ask for its
  erasure once told what it means and ticking that they understand. Where the shop has a wishlist
  page, as the header may link to, it links to it too: their wishlist is kept with their account
  once they are signed in (ADR-575). It links to their address book (ADR-584), saying which
  address is their default.
{%- endcomment -%}
<div class="page-width section-spacing account">
  <div class="section-title">
    <h1>{{ 'customer.account.title' | t }}</h1>
    {%- if customer -%}
      <form method="post" action="{{ routes.account_logout_url }}">
        <button type="submit" class="button button--secondary">{{ 'customer.account.sign_out' | t }}</button>
      </form>
    {%- endif -%}
  </div>
  {%- if customer -%}
    <p class="account__who">
      {%- if customer.first_name -%}
        <span dir="auto">{{ 'customer.account.greeting' | t: name: customer.first_name }}</span>
      {% endif -%}
      <bdi dir="ltr">{{ customer.phone | escape }}</bdi>
    </p>

    {%- if section.settings.wishlist -%}
      {%- if routes.root_url == '/' -%}
        {%- assign wishlist_url = '/pages/wishlist' -%}
      {%- else -%}
        {%- assign wishlist_url = routes.root_url | append: '/pages/wishlist' -%}
      {%- endif -%}
      <p class="account__wishlist">
        <a href="{{ wishlist_url }}">{{ 'customer.account.wishlist' | t }}</a>
        <span class="account__muted">{{ 'customer.account.wishlist_note' | t }}</span>
      </p>
    {%- endif -%}

    <p class="account__addresses">
      <a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }}</a>
      {%- if customer.default_address -%}
        <span class="account__muted" dir="auto">{{ 'customer.account.default_address' | t: address: customer.default_address.summary }}</span>
      {%- endif -%}
    </p>

    {%- assign credit = customer.store_credit_account -%}
    {%- if credit.balance > 0 or credit.transactions.size > 0 -%}
      <div class="account__credit">
        <h2>{{ 'customer.account.store_credit' | t }}</h2>
        <p class="account__credit-balance">{{ credit.balance | money }}</p>
        {%- if credit.expiring -%}
          {%- assign expiring_amount = credit.expiring.amount | money -%}
          {%- assign expiring_on = credit.expiring.expires_at | date: format: 'day_month_year' -%}
          <p class="account__muted">
            {{- 'customer.account.store_credit_expiring' | t: amount: expiring_amount, date: expiring_on -}}
          </p>
        {%- endif -%}
        <p class="account__muted">{{ 'customer.account.store_credit_note' | t }}</p>
        {%- if credit.transactions.size > 0 -%}
          <h3>{{ 'customer.account.store_credit_history' | t }}</h3>
          <ul class="account__credit-history" role="list">
            {%- for entry in credit.transactions -%}
              <li class="account__credit-entry">
                <span class="account__muted">{{ entry.created_at | date: format: 'day_month_year' }}</span>
                <span>
                  {%- case entry.kind -%}
                    {%- when 'credit' -%}
                      {%- if entry.event == 'order_refund' -%}
                        {{- 'customer.account.store_credit_refunded' | t -}}
                      {%- elsif entry.event == 'order_cancellation' -%}
                        {{- 'customer.account.store_credit_given_back' | t -}}
                      {%- else -%}
                        {{- 'customer.account.store_credit_given' | t -}}
                      {%- endif -%}
                    {%- when 'debit' -%}
                      {%- if entry.event == 'order_payment' -%}
                        {{- 'customer.account.store_credit_spent' | t -}}
                      {%- else -%}
                        {{- 'customer.account.store_credit_taken' | t -}}
                      {%- endif -%}
                    {%- when 'debit_revert' -%}
                      {{- 'customer.account.store_credit_given_back' | t -}}
                    {%- else -%}
                      {{- 'customer.account.store_credit_expired' | t -}}
                  {%- endcase -%}
                  {%- if entry.order -%}
                    {{ ' · ' }}
                    {%- if entry.order.url -%}
                      <a href="{{ entry.order.url }}">{{ entry.order.name }}</a>
                    {%- else -%}
                      {{ entry.order.name }}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if entry.expires_at -%}
                    {%- assign entry_expires = entry.expires_at | date: format: 'day_month_year' -%}
                    <span class="account__muted"> · {{ 'customer.account.store_credit_expires' | t: date: entry_expires }}</span>
                  {%- endif -%}
                </span>
                <span class="account__credit-amount" dir="ltr">
                  {%- if entry.amount > 0 -%}+{%- else -%}−{%- endif -%}
                  {{- entry.amount | abs | money -}}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Their link to bring friends, while the shop rewards it (ADR-809). {%- endcomment -%}
    {%- if customer.referral -%}
      {%- assign referral_url = shop.url | append: customer.referral.path -%}
      {%- assign referral_earned = customer.referral.referrer_credit | money -%}
      {%- assign referral_given = customer.referral.friend_credit | money -%}
      {%- assign referral_message = 'customer.account.referral_message' | t: shop: shop.name, url: referral_url -%}
      <div class="account__referral">
        <h2>{{ 'customer.account.referral' | t }}</h2>
        <p>
          {%- if customer.referral.friend_credit > 0 -%}
            {{- 'customer.account.referral_note' | t: earned: referral_earned, given: referral_given -}}
          {%- else -%}
            {{- 'customer.account.referral_note_yours' | t: earned: referral_earned -}}
          {%- endif -%}
        </p>
        <label for="ReferralLink">{{ 'customer.account.referral_link' | t }}</label>
        <input id="ReferralLink" class="account__referral-link" type="text" dir="ltr" readonly value="{{ referral_url }}">
        <a class="button" href="https://wa.me/?text={{ referral_message | url_encode }}" target="_blank" rel="noopener">
          {{- 'customer.account.referral_share' | t -}}
        </a>
      </div>
    {%- endif -%}

    <h2>{{ 'customer.account.orders' | t }}</h2>
    {%- if customer.orders_count == 0 -%}
      <p>{{ 'customer.account.no_orders' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'customer.account.start_shopping' | t }}</a>
    {%- else -%}
      <ul class="account__orders" role="list">
        {%- for order in customer.orders -%}
          <li class="account__order">
            <div class="account__order-head">
              {%- if order.url -%}
                <a href="{{ order.url }}" aria-label="{{ 'customer.account.view_order' | t: name: order.name }}"><bdi>{{ order.name | escape }}</bdi></a>
              {%- else -%}
                <bdi>{{ order.name | escape }}</bdi>
              {%- endif -%}
              <span class="account__muted">{{ order.created_at | time_tag: format: 'day_month_year' }}</span>
            </div>
            <dl class="account__order-details">
              <div>
                <dt>{{ 'customer.account.payment' | t }}</dt>
                <dd>
                  {%- if order.cancelled -%}
                    {{ 'customer.account.cancelled' | t }}
                  {%- else -%}
                    {{ order.financial_status_label | escape }}
                  {%- endif -%}
                </dd>
              </div>
              <div>
                <dt>{{ 'customer.account.delivery' | t }}</dt>
                <dd>{{ order.fulfillment_status_label | escape }}</dd>
              </div>
              <div>
                <dt>{{ 'customer.account.items' | t: count: order.item_count }}</dt>
                <dd>{{ order.total_price | money }}</dd>
              </div>
            </dl>
            {%- if order.line_items.size > 0 -%}
              <ul class="account__order-items" role="list" aria-label="{{ 'customer.account.order_items' | t: name: order.name }}">
                {%- for item in order.line_items -%}
                  <li>
                    <span dir="auto">{{ item.title | escape }}</span>
                    {%- if item.variant_title %} <span class="account__muted" dir="auto">{{ item.variant_title | escape }}</span>{% endif %}
                    <bdi>× {{ item.quantity }}</bdi>
                    {%- unless item.available %} <span class="account__muted">{{ 'customer.account.unavailable' | t }}</span>{% endunless -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if order.reorder_url -%}
              <form method="post" action="{{ order.reorder_url }}" class="account__reorder">
                <button type="submit" class="button button--secondary" aria-label="{{ 'customer.account.buy_again_label' | t: name: order.name }}">{{ 'customer.account.buy_again' | t }}</button>
              </form>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%} Their orders from the store the shop moved from (ADR-786): no page, nothing to buy again. {%- endcomment -%}
    {%- if customer.past_orders.size > 0 -%}
      <section class="account__past" aria-labelledby="past-orders-title">
        <h2 id="past-orders-title">{{ 'customer.account.past_orders' | t }}</h2>
        <p class="account__muted">{{ 'customer.account.past_orders_hint' | t }}</p>
        <ul class="account__orders" role="list">
          {%- for order in customer.past_orders -%}
            <li class="account__order">
              <div class="account__order-head">
                <bdi>{{ order.name | escape }}</bdi>
                <span class="account__muted">{{ order.created_at | time_tag: format: 'day_month_year' }}</span>
              </div>
              <dl class="account__order-details">
                <div>
                  <dt>{{ 'customer.account.payment' | t }}</dt>
                  <dd>
                    {%- if order.cancelled -%}
                      {{ 'customer.account.cancelled' | t }}
                    {%- else -%}
                      {{ order.financial_status_label | escape }}
                    {%- endif -%}
                  </dd>
                </div>
                <div>
                  <dt>{{ 'customer.account.delivery' | t }}</dt>
                  <dd>{{ order.fulfillment_status_label | escape }}</dd>
                </div>
                <div>
                  <dt>{{ 'customer.account.items' | t: count: order.item_count }}</dt>
                  <dd>{{ order.total_price | money }}</dd>
                </div>
              </dl>
              {%- if order.line_items.size > 0 -%}
                <ul class="account__order-items" role="list" aria-label="{{ 'customer.account.order_items' | t: name: order.name }}">
                  {%- for item in order.line_items -%}
                    <li>
                      <span dir="auto">{{ item.title | escape }}</span>
                      {%- if item.variant_title %} <span class="account__muted" dir="auto">{{ item.variant_title | escape }}</span>{% endif %}
                      <bdi>× {{ item.quantity }}</bdi>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    {%- assign data = customer.data_requests -%}
    <section class="account__data" id="your-data" aria-labelledby="your-data-title">
      <h2 id="your-data-title">{{ 'customer.account.data.title' | t }}</h2>
      {%- if data.notice -%}
        <p class="account__notice" role="status">{{ data.notice.message | escape }}</p>
      {%- endif -%}
      {%- if data.available -%}
        <div class="account__data-part">
          <h3>{{ 'customer.account.data.export_title' | t }}</h3>
          <p>{{ 'customer.account.data.export_intro' | t }}</p>
          {%- if data.export -%}
            {%- assign kept_until = data.export.expires_at | date: format: 'day_month_year' -%}
            <a class="button" href="{{ data.export.url }}">{{ 'customer.account.data.export_download' | t }}</a>
            <p class="account__muted">{{ 'customer.account.data.export_kept' | t: date: kept_until }}</p>
          {%- else -%}
            {%- form 'customer_data_export' -%}
              <button type="submit" class="button button--secondary">{{ 'customer.account.data.export_button' | t }}</button>
            {%- endform -%}
          {%- endif -%}
        </div>
        <div class="account__data-part">
          <h3>{{ 'customer.account.data.erase_title' | t }}</h3>
          {%- if data.erasure -%}
            {%- assign erase_after = data.erasure.erase_after | date: format: 'day_month_year' -%}
            {%- if data.erasure.state == 'held' -%}
              <p>{{ 'customer.account.data.erase_held' | t: date: erase_after }}</p>
            {%- else -%}
              <p>{{ 'customer.account.data.erase_waiting' | t: date: erase_after }}</p>
            {%- endif -%}
            <p class="account__muted">{{ 'customer.account.data.erase_cancel' | t }}</p>
          {%- else -%}
            <p>{{ 'customer.account.data.erase_intro' | t }}</p>
            <ul class="account__data-rules">
              <li>{{ 'customer.account.data.erase_rule_wait' | t: count: data.erasure_wait_days }}</li>
              <li>{{ 'customer.account.data.erase_rule_orders' | t }}</li>
              <li>{{ 'customer.account.data.erase_rule_credit' | t }}</li>
              <li>{{ 'customer.account.data.erase_rule_kept' | t }}</li>
              <li>{{ 'customer.account.data.erase_rule_account' | t }}</li>
            </ul>
            {%- form 'customer_data_erase', class: 'account__erase' -%}
              <label class="account__confirm">
                <input type="checkbox" name="customer[confirm]" value="1" required>
                <span>{{ 'customer.account.data.erase_confirm' | t }}</span>
              </label>
              <button type="submit" class="button button--secondary">{{ 'customer.account.data.erase_button' | t }}</button>
            {%- endform -%}
          {%- endif -%}
        </div>
      {%- else -%}
        <p>{{ 'customer.account.data.none' | t }}</p>
      {%- endif -%}
    </section>
  {%- else -%}
    <a class="button" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
  {%- endif -%}
</div>

{% stylesheet %}
  .account { max-inline-size: 48rem; }
  .account__who { margin-block: 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; }
  .account__wishlist { margin-block: -0.75rem 1.5rem; display: grid; gap: 0.25rem; }
  .account__addresses { margin-block: -0.75rem 1.5rem; display: grid; gap: 0.25rem; }
  .account__muted { color: var(--color-muted); font-size: 0.875rem; }
  .account__credit { margin-block-end: 2rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; }
  .account__credit h2 { margin-block-start: 0; font-size: 1rem; }
  .account__credit p { margin: 0.25rem 0 0; }
  .account__credit-balance { font-size: 1.5rem; font-weight: 700; }
  .account__referral { display: flex; flex-direction: column; gap: 0.5rem; margin-block-end: 2rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; }
  .account__referral h2 { margin: 0; font-size: 1rem; }
  .account__referral p { margin: 0; }
  .account__referral-link { min-height: 3rem; padding-inline: 0.75rem; border: 1px solid var(--color-border); border-radius: 0.25rem; font: inherit; }
  .account__referral .button { align-self: flex-start; }
  .account__orders { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  .account__order { padding: 1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; }
  .account__order-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; font-weight: 600; }
  .account__order-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 0.5rem 1rem; margin: 0.75rem 0 0; }
  .account__order-details dt { color: var(--color-muted); font-size: 0.875rem; }
  .account__order-details dd { margin: 0; }
  .account__order-items { margin: 0.75rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.25rem; font-size: 0.875rem; }
  .account__reorder { margin-block-start: 0.75rem; }
  .account__data { margin-block-start: 2.5rem; }
  .account__notice { padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; }
  .account__data-part { margin-block-end: 1.5rem; }
  .account__data-part h3 { margin-block-end: 0.25rem; font-size: 1rem; }
  .account__data-rules { padding-inline-start: 1.25rem; display: grid; gap: 0.25rem; }
  .account__erase { display: grid; justify-items: start; gap: 0.75rem; }
  .account__confirm { display: flex; align-items: center; gap: 0.5rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "wishlist",
      "label": "t:sections.main-account.settings.wishlist.label",
      "info": "t:sections.main-account.settings.wishlist.info",
      "default": false
    }
  ]
}
{% endschema %}
