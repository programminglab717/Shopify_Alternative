<footer class="footer">
  <div class="page-width footer__inner">
    <ul class="footer__menu" role="list">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}" dir="auto">{{ link.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
    {%- if shop.policies.size > 0 -%}
      <ul class="footer__policies" role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if cod.available -%}
      <p class="footer__cod">{{ 'footer.cod' | t }}</p>
    {%- endif -%}
    {%- comment -%}
      The shop's notifications (OS-14, ADR-836): offered once the platform's script says the
      browser can have them and they are off; a tap asks the shopper's leave and turns them on.
    {%- endcomment -%}
    {%- if section.settings.notifications -%}
      <hatti-notifications class="footer__notifications" hidden>
        <button type="button" class="footer__notify" data-on>{{ 'footer.notifications_on' | t }}</button>
        <p data-done hidden>{{ 'footer.notifications_done' | t }}</p>
        <p data-denied hidden>{{ 'footer.notifications_denied' | t }}</p>
      </hatti-notifications>
    {%- endif -%}
    {%- assign year = 'now' | date: '%Y' -%}
    <p class="footer__rights">{{ 'footer.rights' | t: year: year, shop: shop.name }}</p>
    {%- if shop.verified -%}
      <p class="footer__verified"><span aria-hidden="true">✓</span> {{ 'footer.verified' | t }}</p>
    {%- endif -%}
    {%- comment -%} Reporting the store to Hatti, on every store's pages (ADR-460). {%- endcomment -%}
    {%- if routes.root_url == '/' -%}
      {%- assign report_url = '/report' -%}
    {%- else -%}
      {%- assign report_url = routes.root_url | append: '/report' -%}
    {%- endif -%}
    <p class="footer__report"><a href="{{ report_url }}" rel="nofollow">{{ 'footer.report' | t }}</a></p>
    {%- if powered_by_link != blank -%}
      <p class="footer__powered">{{ powered_by_link }}</p>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .footer { margin-block-start: 3rem; padding-block: 2rem; background: var(--color-muted-background); }
  .footer__inner { display: grid; gap: 1rem; }
  .footer__menu { display: flex; flex-wrap: wrap; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .footer__menu a { color: inherit; }
  .footer__policies { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0; padding: 0; list-style: none; font-size: 0.875rem; }
  .footer__policies a { color: var(--color-muted); }
  .footer__rights { color: var(--color-muted); font-size: 0.875rem; }
  .footer__verified { margin: 0; font-size: 0.875rem; font-weight: 600; }
  .footer__report { margin: 0; font-size: 0.75rem; }
  .footer__report a { color: var(--color-muted); }
  .footer__powered { margin: 0; font-size: 0.75rem; }
  .footer__powered a { color: var(--color-muted); }
  .footer__notify { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; cursor: pointer; }
  .footer__notifications p { margin: 0; font-size: 0.875rem; color: var(--color-muted); }
{% endstylesheet %}

{% javascript %}
  class HattiNotifications extends HTMLElement {
    async connectedCallback() {
      const push = window.HattiPush;
      if (!push || !push.supported || (await push.subscribed())) return;
      const button = this.querySelector('[data-on]');
      this.hidden = false;
      button.addEventListener('click', async () => {
        button.disabled = true;
        const answer = await push.subscribe().catch(() => 'failed');
        button.hidden = answer === 'subscribed' || answer === 'denied';
        button.disabled = false;
        this.querySelector('[data-done]').hidden = answer !== 'subscribed';
        this.querySelector('[data-denied]').hidden = answer !== 'denied';
      });
    }
  }
  if (!customElements.get('hatti-notifications')) {
    customElements.define('hatti-notifications', HattiNotifications);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.footer.settings.menu.label",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "notifications",
      "label": "t:sections.footer.settings.notifications.label",
      "info": "t:sections.footer.settings.notifications.info",
      "default": true
    }
  ]
}
{% endschema %}
