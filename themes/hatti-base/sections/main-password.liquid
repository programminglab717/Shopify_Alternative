<div class="page-width section-spacing password">
  <h1 dir="auto">{{ shop.name | escape }}</h1>
  <p class="password__lead">{{ 'sections.password.opening_soon' | t }}</p>
  {%- comment -%} What the shop tells shoppers, made safe when it was published. {%- endcomment -%}
  {%- if shop.password_message != blank -%}
    <div class="password__message rte" dir="auto">{{ shop.password_message }}</div>
  {%- endif -%}
  {%- comment -%}
    The pre-launch waitlist (ADR-446): Shopify's customer form, tagged waitlist, signing the
    shopper up for the shop's news on WhatsApp in the words shown; once the shop opens, each is
    told so once. The form comes back here saying how it went.
  {%- endcomment -%}
  {%- assign consent = 'sections.password.waitlist_consent' | t: shop: shop.name -%}
  {%- form 'customer', id: 'waitlist', class: 'password__waitlist' -%}
    {%- if form.posted_successfully? -%}
      <p class="password__waitlist-success" role="status">{{ 'sections.password.waitlist_success' | t }}</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="waitlist">
      <input type="hidden" name="contact[consent]" value="{{ consent }}">
      {%- liquid
        assign back = request.path
        if routes.root_url != '/'
          assign back = routes.root_url | append: request.path
        endif
      -%}
      <input type="hidden" name="return_to" value="{{ back | escape }}#waitlist">
      <label for="waitlist-phone">{{ consent }}</label>
      <div class="password__field">
        <input
          id="waitlist-phone"
          type="tel"
          name="contact[phone]"
          autocomplete="tel"
          inputmode="tel"
          dir="ltr"
          required
          placeholder="0300 1234567"
          aria-label="{{ 'sections.newsletter.phone' | t }}"
          {%- if form.errors %} aria-invalid="true" aria-describedby="waitlist-error"{% endif %}
        >
        <button class="button" type="submit">{{ 'sections.password.waitlist_submit' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p id="waitlist-error" class="password__error" role="alert">{{ 'sections.newsletter.error' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  {%- endform -%}
  {%- form 'storefront_password', class: 'password__form' -%}
    <label for="Password">{{ 'sections.password.intro' | t }}</label>
    <div class="password__field">
      <input
        type="password"
        name="password"
        id="Password"
        autocomplete="current-password"
        placeholder="{{ 'sections.password.label' | t }}"
        required
        {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}
      >
      <button class="button" type="submit">{{ 'sections.password.enter' | t }}</button>
    </div>
    {%- if form.errors -%}
      <p id="PasswordError" class="password__error" role="alert">{{ 'sections.password.wrong' | t }}</p>
    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .password { max-inline-size: 32rem; text-align: center; }
  .password__lead { font-size: 1.25rem; }
  .password__form, .password__waitlist { margin-block-start: 2rem; display: grid; gap: 0.75rem; }
  .password__waitlist-success { margin: 0; }
  .password__field { display: flex; gap: 0.5rem; }
  .password__field input { flex: 1; min-inline-size: 0; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 4px; font: inherit; }
  .password__error { color: #b42318; margin: 0; }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main-password.name" }
{% endschema %}
