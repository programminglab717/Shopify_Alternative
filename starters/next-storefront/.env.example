# The shop's storefront: its own domain, or its handle's at hatti.pk.
HATTI_STORE_DOMAIN=zari.hatti.pk
# A public Storefront API token, made in the admin's Settings › Apps (ADR-848).
HATTI_STOREFRONT_TOKEN=
# The Storefront API's version, as Shopify's: any of its dated versions answers the same.
HATTI_API_VERSION=2025-01
