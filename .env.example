# Local development settings. Copy to .env (git-ignored): cp .env.example .env
NODE_ENV=development
LOG_LEVEL=info

# Superuser, used only by `pnpm db:setup` (creates the database and logins) and by tests.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Request-serving login. Row-level security limits it to one shop per transaction.
DATABASE_URL=postgres://hatti_app:hatti_app@localhost:5432/hatti
# Cell-wide jobs such as the outbox relay. Sees every shop; give it only to processes that need it.
DATABASE_SYSTEM_URL=postgres://hatti_system:hatti_system@localhost:5432/hatti
# To run like production, through PgBouncer in transaction mode (see db/pgbouncer/pgbouncer.ini),
# use port 6432 in the three request-serving URLs, and keep the relay's LISTEN on a direct
# connection, since a transaction pooler loses notifications:
# DATABASE_LISTEN_URL=postgres://hatti_system:hatti_system@localhost:5432/hatti
# Staff accounts, credentials and sessions. Only the identity module uses it.
DATABASE_IDENTITY_URL=postgres://hatti_identity:hatti_identity@localhost:5432/hatti

# Keys for secrets at rest, such as authenticator-app seeds: "id:base64key", newest first.
# This one is for local development only. For any shared environment, generate keys with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# and keep them in the secret manager.
ENCRYPTION_KEYS=dev:w4lOEQUUBA6nkQTf84p2hmgomQTEky6Cs68n+7oqATw=
# Check new staff passwords against known breaches (Pwned Passwords). Needs internet access; fails
# open when the service is unreachable.
PASSWORD_BREACH_CHECK=true

REDIS_URL=redis://localhost:6379

HOST=0.0.0.0
PORT=4000
# Where customers reach the API's public pages, such as the links that confirm draft orders.
# Required in production; locally the API serves its own links at http://localhost:PORT.
# PUBLIC_URL=https://hatti.pk
# Where storefronts answer, each at its shop's handle's subdomain (zari.hatti.pk). Required in
# production; locally pnpm dev:storefront serves them at http://{handle}.localhost:4100.
# STOREFRONT_URL=https://hatti.pk
# Where shops point domains of their own with a CNAME record: shops.{STOREFRONT_URL's host}
# unless set. localtest.me lets you try one locally (see getting-started).
# STOREFRONT_DNS_TARGET=shops.hatti.pk
# The key storefronts present to the API's /storefront/ routes, such as carts'. Both the API and
# pnpm dev:storefront read it. This one is for local development only; for any shared
# environment, generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STOREFRONT_SERVICE_KEY=dev-storefront-key-for-local-use-only
# Where storefronts reach the API for carts; http://localhost:4000 unless set.
# CORE_API_URL=http://localhost:4000
# Cloudflare, in front of storefronts: the zone their pages are kept in, and a token that may
# purge its cache. The worker purges the pages of what changes; locally there is no edge.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# Traces and metrics (optional). Start the local stack with
#   docker compose --profile observability up -d
# then uncomment these and open Grafana at http://localhost:3000.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_METRIC_EXPORT_INTERVAL=10000
