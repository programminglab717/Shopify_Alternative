# Local development settings. Copy to .env (git-ignored): cp .env.example .env
NODE_ENV=development
LOG_LEVEL=info

# Superuser, used only by `pnpm db:setup` (creates the database and logins) and by tests.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Request-serving login. Row-level security limits it to one shop per transaction.
DATABASE_URL=postgres://hatti_app:hatti_app@localhost:5432/hatti
# Cell-wide jobs such as the outbox relay. Sees every shop; give it only to processes that need it.
DATABASE_SYSTEM_URL=postgres://hatti_system:hatti_system@localhost:5432/hatti
# Staff accounts, credentials and sessions. Only the identity module uses it.
DATABASE_IDENTITY_URL=postgres://hatti_identity:hatti_identity@localhost:5432/hatti

# Keys for secrets at rest, such as authenticator-app seeds: "id:base64key", newest first.
# This one is for local development only. For any shared environment, generate keys with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# and keep them in the secret manager.
ENCRYPTION_KEYS=dev:w4lOEQUUBA6nkQTf84p2hmgomQTEky6Cs68n+7oqATw=
# Check new staff passwords against known breaches (Pwned Passwords). Needs internet access; fails
# open when the service is unreachable.
PASSWORD_BREACH_CHECK=true

REDIS_URL=redis://localhost:6379

HOST=0.0.0.0
PORT=4000

# Traces and metrics (optional). Start the local stack with
#   docker compose --profile observability up -d
# then uncomment these and open Grafana at http://localhost:3000.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_METRIC_EXPORT_INTERVAL=10000
