# The pilot's settings (ADR-989): every service of compose.yml reads this file, as hatti.env.
# Make hatti.env with `./init.sh <domain> <email>`, which fills in the domain and generates every
# password and key below; then fill in the partners' accounts as they come (OWN-* in
# docs/engineering/owner-actions.md). Each setting is described in the repository's .env.example.
# Never commit hatti.env.

NODE_ENV=production
LOG_LEVEL=info

# The proxy's hosts (Caddyfile), each with a DNS A record to this machine; shops' subdomains with
# a wildcard record, *.__DOMAIN__.
ADMIN_HOST=admin.__DOMAIN__
API_HOST=api.__DOMAIN__
STOREFRONT_HOST=__DOMAIN__
ACME_EMAIL=__EMAIL__

# The core's and the storefront's addresses, as the proxy serves them.
PUBLIC_URL=https://api.__DOMAIN__
ADMIN_URL=https://admin.__DOMAIN__
STOREFRONT_URL=https://__DOMAIN__
STOREFRONT_DNS_TARGET=shops.__DOMAIN__
STOREFRONT_EDITOR_ORIGINS=https://admin.__DOMAIN__
PASSKEY_ORIGINS=https://admin.__DOMAIN__
PASSKEY_RP_ID=__DOMAIN__
CORE_API_URL=http://api:4000
# Only the proxy reaches them, on the machine's own network: shoppers' addresses are its to say.
TRUST_PROXY=true

# Postgres on this machine (compose.yml's postgres), its superuser for setting up and migrating,
# and the platform's three logins, which setup makes with these passwords.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_ADMIN_URL=postgres://postgres:__POSTGRES_PASSWORD__@postgres:5432/postgres
DATABASE_URL=postgres://hatti_app:__APP_PASSWORD__@postgres:5432/hatti
DATABASE_SYSTEM_URL=postgres://hatti_system:__SYSTEM_PASSWORD__@postgres:5432/hatti
DATABASE_IDENTITY_URL=postgres://hatti_identity:__IDENTITY_PASSWORD__@postgres:5432/hatti
REDIS_URL=redis://valkey:6379

# Secrets at rest, and the key storefronts present to the core, generated by init.sh. Keep a copy
# of ENCRYPTION_KEYS off the machine: without it, what was sealed with it cannot be opened.
ENCRYPTION_KEYS=pilot:__ENCRYPTION_KEY__
STOREFRONT_SERVICE_KEY=__STOREFRONT_SERVICE_KEY__
PASSWORD_BREACH_CHECK=true

# Files shops upload: an S3 bucket, as production requires (OWN-27). Cloudflare R2's free tier
# holds 10 GB; any S3-compatible store will do. Then set the bucket's CORS rule for ADMIN_URL once:
#   docker compose run --rm api node dist/storage-cors.js apply
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=hatti-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (OWN-26): without it, no email is sent in production.
# SES_REGION=ap-southeast-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# EMAIL_FROM=Hatti <no-reply@__DOMAIN__>

# WhatsApp (OWN-23) and SMS (OWN-10), for sign-in codes, confirmations and updates.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
# SMS_SENDER=Hatti

# Errors (OWN-05): a self-hosted GlitchTip project's DSN.
# ERROR_TRACKING_DSN=
# ERROR_TRACKING_ENVIRONMENT=pilot
